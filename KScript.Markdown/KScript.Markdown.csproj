<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript.Markdown</RootNamespace>
    <AssemblyName>KScript.Markdown</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>KScript.Markdown: Markdown to HTML, with front matter.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KScript.Core\KScript.Core.csproj" />
    <PackageReference Include="Markdig" Version="0.38.0" />
  </ItemGroup>

</Project>
