<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript.Mathematics</RootNamespace>
    <AssemblyName>KScript.Math</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>KScript.Math: square roots, trigonometry, rounding, random numbers and statistics.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KScript.Core\KScript.Core.csproj" />
  </ItemGroup>

</Project>
