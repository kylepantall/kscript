<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript</RootNamespace>
    <AssemblyName>KScript.Web</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>KScript.Web: pages served by kscript serve, with layouts, components and live blocks.</Description>
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- kscript serve runs on Kestrel -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pages\model-forms.js" LogicalName="KScript.Pages.model-forms.js" />
    <EmbeddedResource Include="Pages\live.js" LogicalName="KScript.Pages.live.js" />
    <EmbeddedResource Include="Pages\live-dom.js" LogicalName="KScript.Pages.live-dom.js" />
    <EmbeddedResource Include="Pages\live-sort.js" LogicalName="KScript.Pages.live-sort.js" />
    <EmbeddedResource Include="Pages\live-drag.js" LogicalName="KScript.Pages.live-drag.js" />
    <EmbeddedResource Include="Pages\live-portals.js" LogicalName="KScript.Pages.live-portals.js" />
    <EmbeddedResource Include="Pages\live-hooks.js" LogicalName="KScript.Pages.live-hooks.js" />
    <EmbeddedResource Include="Pages\live-navigation.js" LogicalName="KScript.Pages.live-navigation.js" />
    <EmbeddedResource Include="Pages\live-stream.js" LogicalName="KScript.Pages.live-stream.js" />
    <EmbeddedResource Include="Pages\browser-reload.js" LogicalName="KScript.Pages.browser-reload.js" />
    <EmbeddedResource Include="Pages\passkeys.js" LogicalName="KScript.Pages.passkeys.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KScript.Tests" />
    <InternalsVisibleTo Include="KScript.Language.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KScript.Core\KScript.Core.csproj" />
    <ProjectReference Include="..\KScript.Style\KScript.Style.csproj" />
    <ProjectReference Include="..\KScript.Markdown\KScript.Markdown.csproj" />
  </ItemGroup>

</Project>
