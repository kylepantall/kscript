<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript</RootNamespace>
    <AssemblyName>KScriptLib</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.1.0</Version>
    <Product>KScript</Product>
    <Description>An XML-based scripting language parser and interpreter.</Description>
    <NoWarn>$(NoWarn);IDE1006;CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- kscript serve runs on Kestrel -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pages\live.js" LogicalName="KScript.Pages.live.js" />
    <!-- Built-in templates for kscript make -->
    <EmbeddedResource Include="Scaffolding\Templates\*" LogicalName="KScript.Scaffolding.Templates.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KScript.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathParser.org-mXparser" Version="4.2.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Markdig" Version="0.38.0" />
  </ItemGroup>

</Project>
