<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript</RootNamespace>
    <AssemblyName>KScript.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>The KScript 2 runtime: values, scopes, the expression evaluator, the package system, and the core language (let, set, if, for, while, match, fn, try, import, echo).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KScript.Tests" />
    <InternalsVisibleTo Include="KScript.Http" />
    <InternalsVisibleTo Include="KScript.Web" />
    <InternalsVisibleTo Include="KScript.Queue" />
    <InternalsVisibleTo Include="KScript.Language" />
    <InternalsVisibleTo Include="KScript.Data" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <ProjectReference Include="..\KScript.Syntax\KScript.Syntax.csproj" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>

</Project>
