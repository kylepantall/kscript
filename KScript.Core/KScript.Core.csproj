<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript</RootNamespace>
    <AssemblyName>KScript.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>The KScript 2 runtime: values, scopes, the expression evaluator, the package system, and the core language (let, set, if, for, while, match, fn, try, import, echo).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KScript.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KScript.Syntax\KScript.Syntax.csproj" />
  </ItemGroup>

</Project>
