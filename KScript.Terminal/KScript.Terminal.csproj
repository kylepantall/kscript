<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript.Terminal</RootNamespace>
    <AssemblyName>KScript.Terminal</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>KScript.Terminal: prompts, menus, colours and Markdown output for terminal scripts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KScript.Core\KScript.Core.csproj" />
    <ProjectReference Include="..\KScript.Markdown\KScript.Markdown.csproj" />
  </ItemGroup>

</Project>
