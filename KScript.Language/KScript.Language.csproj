<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript.Language</RootNamespace>
    <AssemblyName>KScript.Language</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>KScript 2 front end: position-aware markup and expression parsers, the language catalog and the analyzer used by the language server.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KScript.Language.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KScript\KScript.csproj" />
  </ItemGroup>

</Project>
