import KScript.Web
import "../models/profile.kscript"

type ProfileEditor extends Component {
  record: Profile

  fn render(): Component {
    return ```html
    <live id="profile-{$.record.id}">
      <state name="automatic" value="false" />
      <state name="preview" value="false" />
      <p><label><input type="checkbox" bind="automatic"> Save as I type</label></p>
      <form
        model-update="edit_profile"
        key="{$.record.id}"
        autosave="{$.automatic}">
        <p><label>Bio<br><input name="bio" value="{$.record.bio}" maxlength="160"></label></p>
        <button>Save profile</button>
      </form>
      <p><button type="button" on-click="$.preview">{$.preview ? 'Hide saved bio' : 'Show saved bio'}</button></p>
      <if test="$.preview"><p>Saved bio: {$.record.bio}</p></if>
    </live>
    ```
  }
}
