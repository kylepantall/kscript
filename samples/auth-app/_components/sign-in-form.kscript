import KScript.Web
import KScript.Auth

/// The sign-in form. It posts to /login, and the controller shows it again with
/// the email and an error when they don't match an account.
type SignInForm extends Component {
  construct({ email: string = '', error?: string })

  fn render() => ```html
    <status-message />
    <if test="$error != null"><p class="error">{$error}</p></if>
    <form method="post" action="/login">
      {! @csrf_field() }
      <p><label>Email<br><input type="email" name="email" value="{$email}" required autocomplete="email"></label></p>
      <p><label>Password<br><input type="password" name="password" required autocomplete="current-password"></label></p>
      <p><label><input type="checkbox" name="remember" value="yes"> Keep me signed in</label></p>
      <p><button>Sign in</button></p>
    </form>
    <if test="@has_passkeys()"><p><button type="button" passkey="login">Sign in with a passkey</button></p></if>
    ```
}
