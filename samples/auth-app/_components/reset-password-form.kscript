import KScript.Web
import KScript.Auth

/// Sets a new password with the token from a reset link. It posts to
/// /reset-password, and the controller shows it again with an error when the
/// password breaks the project's rules.
type ResetPasswordForm extends Component {
  construct({ token: string, error?: string })

  fn render() => ```html
    <if test="$error != null"><p class="error">{$error}</p></if>
    <form method="post" action="/reset-password">
      {! @csrf_field() }
      <input type="hidden" name="token" value="{$token}">
      <p><label>New password<br><input type="password" name="password" required autocomplete="new-password"></label></p>
      <p><button>Change password</button></p>
    </form>
    ```
}
