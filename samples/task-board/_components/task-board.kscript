import KScript.Web

/// A small task list whose controls are all shorthands. Each handler says the
/// action it runs (toggle:, add: to:, remove: from:, increment:, set: to:,
/// reset:, cycle:, call: with:, emit:), modifiers say when (confirm:, key:,
/// once:), @bind takes options (trim:, debounce:, as:), @each and @if repeat
/// and choose tags, and @class and @show switch classes and visibility.
type TaskBoard extends Component {
  tasks: string[] = ['Buy milk', 'Call the bank']
  done: string[] = []
  draft: string = ''
  search: string = ''
  goal: int = 3
  compact: bool = false
  tips: bool = true
  added: int = 0
  filter: string = 'all'
  view: string = 'list'
  note: string = ''

  fn finish(task: string) {
    done = $done->push($task)
    note = "Finished {$task}"
  }

  fn render() => ```html
    <p @show($tips)>
      Tip: press Escape in the search box to clear it.
      <button type="button" @on-click(toggle: $tips, once: true)>Hide tips</button>
    </p>
    <form @on-submit(add: $draft, to: $tasks, increment: $added, reset: $draft)>
      <input @bind($draft, trim: true) placeholder="New task">
      <button @live-disable(while: $draft == '')>Add</button>
    </form>
    <p>
      <input
        @bind($search, debounce: 300ms, trim: true)
        @on-keydown(reset: $search, key: escape)
        placeholder="Search">
      <label>Goal <input type="number" @bind($goal, as: int)></label>
    </p>
    <p>
      <button type="button" @on-click(toggle: $compact)>Compact</button>
      <button type="button" @on-click(set: $filter, to: 'all')>All</button>
      <button type="button" @on-click(set: $filter, to: 'open')>Open</button>
      <button type="button" @on-click(cycle: $view, through: ['list', 'grid'])>View</button>
    </p>
    <ul @class(compact: $compact, 'is-filtered': $filter == 'open', grid: $view == 'grid')>
      <li
        @each($tasks, as: task)
        @if(($filter == 'all' or not $done->contains($task)) and $task->lower()->contains($search->lower()))>
        <span
          @class({ $done->contains($task): ['done', 'struck'] })
          @drag(copy: true, value: $task)>{$task}</span>
        <button
          type="button"
          @on-click(call: $finish, with: [$task], emit: 'task-finished')>Finish {$task}</button>
        <button
          type="button"
          @on-click(remove: $task, from: $tasks, confirm: 'Remove this task?')>Remove {$task}</button>
      </li>
    </ul>
    <p
      class="drop"
      @on-dblclick(set: $note, to: 'Drag a task here to finish it')
      @on-drop(call: $finish, with: [$event.drag_value])>Drop a task here to finish it</p>
    <p>Added {$added} · Showing {$filter} · {$view} · Goal {$goal}</p>
    <p @if($note)>{$note}</p>
    ```
}
