// Clicks through the task board. Run with: kscript test samples/task-board
import KScript.Web

describe(name: "task board") {
  test(name: "the page starts with two open tasks") {
    page = @visit('/')
    expect($page.text, contains: 'Buy milk')
    expect($page.text, contains: 'Added 0 · Showing all')
    expect($page->classes('Buy milk'), not_contains: 'done')
  }

  test(name: "add: to: puts the draft on the list and set: to: clears it") {
    page = @visit('/')->fill('draft', 'Walk the dog')->submit()
    expect($page.text, contains: 'Remove Walk the dog')
    expect($page.text, contains: 'Added 1')
    expect($page.html, contains: 'value=""')
  }

  test(name: "call: with: runs a method, and @class marks the task done") {
    page = @visit('/')->click('Finish Buy milk')
    expect($page->classes('Buy milk'), equals: ['done', 'struck'])
    expect($page.text, contains: 'Finished Buy milk')
  }

  test(name: "emit: sends an event that another block hears with @on-event") {
    page = @visit('/')
    expect($page.text, contains: 'Finished so far: 0')
    page = $page->click('Finish Buy milk')->click('Finish Call the bank')
    expect($page.text, contains: 'Finished so far: 2')
  }

  test(name: "remove: from: takes a task off the list") {
    page = @visit('/')->click('Remove Call the bank')
    expect($page.text, not_contains: 'Call the bank')
  }

  test(name: "toggle: flips a bool, and @class follows it") {
    page = @visit('/')
    expect($page.html, not_contains: 'class="compact"')
    $page->click('Compact')
    expect($page.html, contains: 'class="compact"')
    $page->click('Compact')
    expect($page.html, not_contains: 'class="compact"')
  }

  test(name: "set: to: picks the filter") {
    page = @visit('/')->click('Finish Buy milk')->click('Open')
    expect($page.text, contains: 'Showing open')
    expect($page.text, not_contains: 'Remove Buy milk')
    expect($page.html, contains: 'class="is-filtered"')
    $page->click('All')
    expect($page.text, contains: 'Remove Buy milk')
  }

  test(name: "a page the site doesn't have is NotFound") {
    expect(@visit('/nope'), throws: NotFound)
  }

  test(name: "trim: tidies the draft, and reset: puts it back to ''") {
    page = @visit('/')->fill('draft', '  Walk the dog  ')->submit()
    expect($page.text, contains: 'Remove Walk the dog')
    expect($page.html, contains: 'value=""')
  }

  test(name: "@live-disable(while:) disables Add until there is a draft") {
    expect(
      @visit('/').html,
      matches: '<button data-ks-live-disable disabled>Add'
    )
  }

  test(name: "key: escape clears the search, and other keys don't") {
    page = @visit('/')->fill('search', 'milk')->press('enter', in: 'Search')
    expect($page.text, not_contains: 'Call the bank')
    $page->press('escape', in: 'Search')
    expect($page.text, contains: 'Call the bank')
  }

  test(name: "cycle: goes round the views") {
    page = @visit('/')->click('View')
    expect($page.text, contains: '· grid ·')
    expect($page.html, contains: 'class="grid"')
    expect($page->click('View').text, contains: '· list ·')
  }

  test(name: "as: int reads the goal as a number, and refuses words") {
    expect(
      @visit('/')->fill('goal', '7')->click('Compact').text,
      contains: 'Goal 7'
    )
    expect(
      @visit('/')->fill('goal', 'seven')->click('Compact'),
      throws: Http
    )
  }

  test(name: "@show hides the tips once they are dismissed") {
    page = @visit('/')
    expect($page.html, not_contains: '<p hidden>')
    expect($page->click('Hide tips').html, contains: '<p hidden>')
  }

  test(name: "modifiers reach the browser") {
    html = @visit('/').html
    expect($html, contains: 'Remove this task?')
    expect($html, contains: 'data-ks-mods-click')
    expect($html, contains: 'data-ks-bind-debounce="300"')
  }
}
