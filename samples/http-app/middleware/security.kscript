import KScript.Http

/// Adds headers that stop other sites framing these pages or browsers guessing
/// content types.
fn secure_headers(request: map, next: fn) {
  return $next($request)
    ->with_header('X-Frame-Options', 'DENY')
    ->with_header('X-Content-Type-Options', 'nosniff')
}

/// Turns away writes that don't send JSON, before the controller runs.
fn json_only(request: map, next: fn) {
  if $request.method != 'GET' and $request.method != 'DELETE' and not ($request.headers['content-type'] ?? '')->contains('json') {
    return @response(
      { error: 'Send JSON (Content-Type: application/json).' },
      status: 415
    )
  }
  return $next($request)
}
