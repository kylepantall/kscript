// API routes: everything here is under /api and answers errors with JSON.
KScript.Routes(middleware: api) {
  import "controllers/people.ks.xml" as people
  import "middleware/security.ks.xml"

  Get(path: "/health", to: people.health)
  Resource(path: "/people", to: people, only: "index, show")

  Group(middleware: "auth, json_only") {
    Resource(path: "/people", to: people, only: "store, update, destroy")
  }
}
