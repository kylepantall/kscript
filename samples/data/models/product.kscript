import KScript.Data
import "stocked.kscript"

/// Something the shop sells.
model Product(unique: [sku]) extends [Stocked, Timestamps] {
  sku: string(max: 20)
  name: string(max: 120)
  price: number(min: 0)
  tags: string[] = []
  orders: Order[]

  fn cheap(query, under: number = 10) =>
    $query->where(fn(p) => $p.price < $under)
}
