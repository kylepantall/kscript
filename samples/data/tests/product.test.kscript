import KScript.Data
import "../models/product.kscript"

// kscript test gives this file its own database in memory, made from the
// migrations, and undoes each test's changes when it ends.
describe(name: 'Product') {
  test(name: 'is saved and found again') {
    tea = Product->create(sku: 'TEA-9', name: 'Black tea', price: 5)
    expect(Product->find($tea.id).name, equals: 'Black tea')
    expect($tea.stock, equals: 0)
  }

  test(name: 'starts each test with no products') {
    expect(Product->count(), equals: 0)
  }

  test(name: 'keeps skus unique') {
    Product->fake(sku: 'TEA-9')
    expect_error(type: UniqueViolation) {
      Product->fake(sku: 'TEA-9')
    }
  }

  test(name: 'lists products in one query') {
    Product->fake_many(3)
    names = Product->order_by(name)->pluck(name)
    expect($names, count: 3)
    expect(@queries(), count_at_most: 4)
  }

  test(name: 'upserts by sku and pages by a stable key') {
    Product->insert([
      { sku: 'TEA-9', name: 'Black tea', price: 5 },
      { sku: 'MUG-1', name: 'Blue mug', price: 8 },
    ])
    Product->upsert({ sku: 'TEA-9', name: 'Green tea', price: 6 }, key: 'sku')
    expect(Product->count(), same: 2)
    expect(Product->where(sku: 'TEA-9')->first().name, same: 'Green tea')

    first = Product->cursor_paginate(per_page: 1)
    expect($first.has_more, same: true)
    second = Product->cursor_paginate(per_page: 1, after: $first.next)
    expect($second.items->first().name, same: 'Blue mug')
    expect($second.has_more, same: false)

    description = @db()->describe_table(Product)
    expect(
      $description.columns->pluck('name')->contains('sku'),
      same: true
    )
  }
}
