import KScript.Terminal
import KScript.IO

input(to: old_dir) "Move files from: "
input(to: new_dir) "Move files to: "
input(to: file_types) "File types (comma separated): "

types = $file_types->split(',')->map(fn($t) => $t->trim())
for file in @files($old_dir) |> filter(fn($f) => $types->contains($f->extension())) {
  target = @join_path($new_dir, $file->name())
  move(from: $file, to: $target)
  echo "Moved {$file} to {$target}"
}
