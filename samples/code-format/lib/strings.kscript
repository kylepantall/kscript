/// Lower-cases text and joins words with dashes, for URLs and file names.
///
/// @param text The text to turn into a slug.
/// @returns The slug, such as `hello-world`.
/// @example
///   @slugify('Hello World')   // 'hello-world'
fn slugify(text) {
  return $text->lower()->replace(' ', '-')
}

/// Upper-cases text. Kept for scripts outside this project that still call it.
/// @public
/// @deprecated Use $text->upper() instead.
fn titlecase(text) => $text->upper()
