kscript {
  import KScript.Queue
  import "../jobs/send-welcome.kscript"
  import "../jobs/orders.kscript"

  describe(name: "jobs") {
    test(name: "signing up queues a welcome email") {
      queue = @fake_queue()
      SendWelcome(user_id: 7, email: 'joan@example.com')->dispatch()
      expect($queue->count_of(SendWelcome), equals: 1)
      expect(
        $queue->pushed(SendWelcome)[0].email,
        equals: 'joan@example.com'
      )
      expect($queue->dispatches()[0].queue, equals: 'mail')
    }

    test(name: "an order runs as a chain") {
      queue = @fake_queue()
      @chain([ChargeCard(order_id: 1, amount: 5), ShipOrder(order_id: 1)])
        ->dispatch()
      expect($queue->count(), equals: 2)
      expect($queue->run_all(), equals: 2)
    }

    test(name: "a job checks its fields") {
      expect(ChargeCard(order_id: 1, amount: 0), throws: Shape)
    }
  }
}
