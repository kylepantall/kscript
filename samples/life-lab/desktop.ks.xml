<!--
  Life Lab as a desktop app: kscript desktop.ks.xml opens it in a window on macOS, Windows or Linux.
  kscript compile (in this folder) builds it as a program: "Life Lab.app" for a Mac, "Life Lab.exe" for Windows.
  The rules come from lib/life.ks.xml, the same script the terminal and browser versions use.
-->
<KScript.Window
  title="Life Lab"
  width="760"
  height="720"
  theme="dark"
  background="#0f172a">
  <import path="lib/life.ks.xml" />

  <let name="cols" value="40" />
  <let name="rows" value="24" />
  <let
    name="world"
    value="@pattern_world('glider_gun', width: $cols, height: $rows)" />
  <let name="playing" value="false" />
  <let name="speed" value="150" />
  <let name="pattern" value="'glider_gun'" />
  <let name="soup" value="30" />
  <let name="wrap" value="true" />
  <let
    name="pattern_choices"
    value="$patterns->keys()->map(fn($k) => { label: $k->replace(old: '_', new: ' ')->capitalize(), value: $k })" />

  <fn name="tick">
    <set name="world" value="@advance($world, generations: 1)" />
    <set name="playing" value="@population($world.grid) gt 0" />
  </fn>

  <Timer every="$speed" when="$playing" on_tick="@tick()" />

  <Column gap="4">
    <Text size="26" weight="bold" color="#e2e8f0">Life Lab</Text>
    <Text color="#94a3b8">Conway's Game of Life, written in KScript. Click cells to draw, then press Play.</Text>
  </Column>

  <Row gap="8" wrap="yes">
    <Button variant="primary" width="80" on_click="playing = not $playing">{ $playing ? 'Pause' : 'Play' }</Button>
    <Button on_click="world = @advance($world, generations: 1); playing = false">Step</Button>
    <Button on_click="world = @advance($world, generations: 10)">+10</Button>
    <Button on_click="world = @advance($world, generations: 50)">+50</Button>
    <Spacer size="8" />
    <Text color="#94a3b8">Speed</Text>
    <Select bind="speed" options="{ Slow: 400, Normal: 150, Fast: 40 }" />
    <Text color="#94a3b8">Pattern</Text>
    <Select
      bind="pattern"
      options="$pattern_choices"
      on_change="world = @pattern_world($pattern, width: $cols, height: $rows, wrap: $world.wrap); playing = false" />
  </Row>

  <Row gap="8" wrap="yes">
    <Button on_click="world = @new_world(@random_grid(width: $cols, height: $rows, density: $soup), wrap: $world.wrap, pattern: 'random soup'); playing = false">Random soup</Button>
    <Slider
      bind="soup"
      min="5"
      max="80"
      step="5"
      width="140"
      tooltip="How full the soup is" />
    <Text color="#94a3b8" width="40">{$soup}%</Text>
    <CheckBox
      bind="wrap"
      on_change="world = $world->merge({ wrap: $event.value })">Wrap edges</CheckBox>
    <Button on_click="world = @new_world(@blank(width: $cols, height: $rows), wrap: $world.wrap); playing = false">Clear</Button>
  </Row>

  <Text color="#cbd5e1" wrap="yes">{ $patterns->has($world.pattern) ? $patterns[$world.pattern].about : 'Your own pattern.' }</Text>

  <Box background="#1e293b" padding="6" radius="6">
    <Grid columns="$cols" gap="1">
      <for each="row" at="y" in="$world.grid">
        <for each="c" at="x" in="$row">
          <Box
            width="16"
            height="16"
            radius="2"
            background="{ $c eq $alive_cell ? '#4ade80' : '#0b1220' }"
            on_click="world = @flip($world, where: $x + ',' + $y)" />
        </for>
      </for>
    </Grid>
  </Box>

  <Row gap="24" wrap="yes">
    <let name="s" value="@summary($world)" />
    <for
      each="stat"
      in="[['Generation', $s.generation], ['Alive', $s.population + ' (' + $s.density + '%)'], ['Born', $s.births], ['Died', $s.deaths], ['Status', $s.status]]">
      <Column gap="2">
        <Text size="11" color="#64748b">{ $stat[0]->upper() }</Text>
        <Text size="16" weight="bold" color="#e2e8f0">{ $stat[1] }</Text>
      </Column>
    </for>
  </Row>

  <Text size="12" color="#64748b">Also runs in a terminal (kscript life.ks.xml) and a browser (kscript serve). Same rules, one script: lib/life.ks.xml.</Text>
</KScript.Window>
