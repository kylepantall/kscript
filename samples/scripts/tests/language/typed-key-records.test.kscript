import "types/key-batch.kscript"

describe(name: 'Typed keys in incoming JSON') {
  test(name: 'each key in a row is normalized independently') {
    body = '{"active":" key_Alpha ","candidates":[" key_alpha ","key_beta "]}'
    batch = $body->json(as: KeyBatch)
    expect($batch.active, same: 'key_Alpha')
    expect($batch.candidates, same: ['key_alpha', 'key_beta'])
  }

  test(name: 'absent and explicit null previous keys both leave the required key intact') {
    without_key = KeyBatch(active: 'key_Alpha', candidates: [])
    with_null = KeyBatch(
      active: 'key_Alpha',
      previous: null,
      candidates: []
    )
    expect($without_key.previous, same: null)
    expect($with_null.previous, same: null)
    expect($with_null.active, same: $without_key.active)
  }

  test(name: 'a present optional key is subject to the same rules as a required one') {
    batch = KeyBatch(
      active: 'key_alpha',
      previous: ' key_beta ',
      candidates: []
    )
    expect($batch.previous, same: 'key_beta')
    problems = KeyBatch->check({
      active: 'key_alpha',
      previous: 'bad',
      candidates: []
    })
    expect($problems->pluck(path)->unique(), same: ['$.previous'])
  }

  test(name: 'invalid and null list items report their own indices') {
    input = {
      active: 'key_Alpha',
      candidates: ['key_alpha', 'key_alpha2', null]
    }
    problems = KeyBatch->check($input)
    expect(
      $problems->pluck(path)->unique(),
      same: ['$.candidates[1]', '$.candidates[2]']
    )
    expect(KeyBatch($input), throws: Shape)
  }

  test(name: 'a missing required array is distinct from an empty array') {
    input = '{"active":"key_Alpha"}'
    expect($input->json(as: KeyBatch), throws: Shape)
    empty = '{"active":"key_Alpha","candidates":[]}'->json(as: KeyBatch)
    expect($empty.candidates, same: [])
  }
}
