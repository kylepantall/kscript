fn issue_product(
  products: string[],
  context: string,
  database_url: string,
  ledger: map
) {
  if $products->count() != 1 {
    throw Validation "Supply exactly one product"
  }
  if $context != 'portal' {
    throw Validation "Run through the portal"
  }
  if $database_url->is_blank() {
    throw Validation "Configure the database"
  }
  ledger.issued = $ledger.issued->push($products[0])
  return "License for {$products[0]}"
}

fn run_issuer(
  products: string[],
  context: string,
  database_url: string,
  ledger: map
) {
  try {
    echo @issue_product($products, $context, $database_url, $ledger)
  } catch Validation as err {
    $log->error($err.message)
  }
}

describe(name: 'License issuer preconditions') {
  before_each {
    log_provider(type: 'memory', replace: true)
    ledger = { issued: [] }
  }

  test(name: 'a valid request prints exactly the issued license') {
    capture(into: out) {
      @run_issuer(['Site Pro'], 'portal', 'db', $ledger)
    }
    expect(value: $out, same: 'License for Site Pro')
    expect(value: $ledger.issued, same: ['Site Pro'])
    expect(value: $log->entries(), count: 0)
  }

  test(name: 'argument count takes priority over context and configuration') {
    capture(into: out) {
      @run_issuer([], 'shell', '', $ledger)
    }
    expect(value: $out, same: '')
    expect(value: $ledger.issued, count: 0)
    expect(
      value: $log->entries()->pluck(message),
      same: ['Supply exactly one product']
    )
  }

  test(name: 'two arguments fail even in a configured portal') {
    expect_error(type: Validation, contains: 'one product') {
      @issue_product(['Site', 'Pro'], 'portal', 'db', $ledger)
    }
    expect(value: $ledger.issued, count: 0)
  }

  test(name: 'a missing issuer context reports its own guard before the database guard') {
    capture(into: out) {
      @run_issuer(['Site Pro'], 'shell', '', $ledger)
    }
    expect(value: $out, same: '')
    expect(
      value: $log->entries()->pluck(message),
      same: ['Run through the portal']
    )
    expect(value: $ledger.issued, count: 0)
  }

  test(name: 'a blank connection reports once and a corrected retry issues once') {
    capture(into: out) {
      @run_issuer(['Pro'], 'portal', '  ', $ledger)
      @run_issuer(['Pro'], 'portal', 'db', $ledger)
    }
    expect(value: $out, same: 'License for Pro')
    expect(
      value: $log->entries()->pluck(message),
      same: ['Configure the database']
    )
    expect(value: $ledger.issued, same: ['Pro'])
  }
}
