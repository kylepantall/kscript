import KScript.IO
import KScript.Net
import KScript.Cache

type TicketRow {
  title: string
  number: int
}

fn round_trip(folder: any) {
  table = $folder->join('tickets.csv')
  @write_csv($table, [{ title: "A, { @char_of(10) }B", number: 7 }])
  rows = @read_csv($table, as: TicketRow)
  expect($rows->first().number, same: 7)
  expect($rows->first().title, same: "A, { @char_of(10) }B")

  payload: base64 = 'AAH/AA=='
  binary = $folder->join('payload.bin')
  @write_bytes($binary, $payload)
  expect(@read_bytes($binary)->to_string(), same: 'AAH/AA==')
  @write_atomic($binary, 'done')
  expect(@read_text($binary), same: 'done')
  return $folder
}

fn fail_in_temp(file: any) {
  @write_text($file, 'temporary')
  throw Validation "{ $file.path }"
}

describe(name: 'Built-in collection and text APIs') {
  test(name: 'transforms and searches preserve order and original indexes') {
    expect([1, 2]->flat_map(fn(x) => [$x, -$x]), same: [1, -1, 2, -2])
    expect(
      [1, 2, 3]->partition(->is_odd()),
      same: [[1, 3], [2]]
    )
    expect(
      ['alpha', 'apple', 'beta']->unique_by(->first()),
      same: ['alpha', 'beta']
    )
    expect(['a', 'b', 'c']->find_last(fn(_x, i) => $i < 2), same: 'b')
  }

  test(name: 'map projection and recursive merge retain intentional nulls') {
    meta = { title: 'Note', views: 2, hidden: true }
    expect(
      $meta->pick(['views', 'title']),
      same: { title: 'Note', views: 2 }
    )
    expect($meta->omit(['hidden']), same: { title: 'Note', views: 2 })
    settings = { nav: { title: 'Home', priority: 2 }, flags: [1] }
    expect(
      $settings->deep_merge({ nav: { title: null }, flags: [2] }),
      same: { nav: { title: null, priority: 2 }, flags: [2] },
    )
  }

  test(name: 'text and signed durations have explicit contracts') {
    expect(
      'pre/pre/file.txt.txt'->strip_prefix('pre/')->strip_suffix('.txt'),
      same: 'pre/file.txt'
    )
    expect(('e' + @char_of(769))->normalize_unicode(), same: 'é')
    start = '2025-04-01T09:00:00Z'->to_date()
    finish = $start + 20m
    expect($start->duration_since($finish).minutes, same: -20)
  }
}

describe(name: 'Scoped files, HTTP and settings') {
  test(name: 'binary bytes and CSV round-trip with cleanup') {
    removed = @with_temp_folder(@round_trip)
    expect(@exists($removed), same: false)
    failed = @with_temp_file(@fail_in_temp) catch Validation => $err.message
    expect(@exists($failed), same: false)
  }

  test(name: 'an HTTP client retries a stub and supports response assertions') {
    client = @http_client(
      'https://example.test/api/',
      options: { retries: 1, retry_delay: 0ms }
    )
    hits = @cache()->group('builtin-api-stub')
    $hits->clear()
    result = @with_http_stub(
      fn(request) =>
      $hits->increment('calls') == 1 ? { status: 503 } : {
        status: 200,
        body: { title: $request.url, number: 7 }
      },
      fn() => $client('tickets'),
    )
    expect($hits->get('calls'), same: 2)
    @assert_response(
      $result,
      status: 200,
      json: { title: 'https://example.test/api/tickets', number: 7 },
      as: TicketRow
    )
    expect(
      @parse_query('?label=a+b&label=c%2Bd&empty'),
      same: { label: ['a b', 'c+d'], empty: '' }
    )
  }

  test(name: 'clock and environment changes are scoped to the callback') {
    before = @env('KSCRIPT_API_TEST_MODE')
    mode = @with_environment(
      { KSCRIPT_API_TEST_MODE: 'demo' },
      fn() => @env('KSCRIPT_API_TEST_MODE')
    )
    expect($mode, same: 'demo')
    expect(@env('KSCRIPT_API_TEST_MODE'), same: $before)
    time = '2025-01-02T12:01:00'->to_date()
    expect(
      @with_clock($time, fn() => @today()->format()),
      same: '2025-01-02'
    )
  }

  test(name: 'cache reservation and grouped invalidation leave other keys alone') {
    store = @cache()->group('builtin-api-reservation')
    $store->clear()
    $store->clear_group('menu')
    menu = $store->group('menu')
    expect($menu->set_if_absent('links', ['Home']), same: true)
    expect($menu->set_if_absent('links', ['Other']), same: false)
    $store->set('outside', true)
    expect($store->clear_group('menu'), same: 1)
    expect($menu->has('links'), same: false)
    expect($store->get('outside'), same: true)
  }
}
