import "types/session-batch.kscript"

describe(name: 'Session keys in incoming JSON') {
  test(name: 'each key in a row is normalized independently') {
    body = '{"active":" passkey_Login ","candidates":[" passkey_A ","passkey_B \
      "]}'
    batch = $body->json(as: SessionBatch)
    expect(value: $batch.active, same: 'passkey_Login')
    expect(value: $batch.candidates, same: ['passkey_A', 'passkey_B'])
  }

  test(name: 'absent and explicit null previous keys both leave the required key intact') {
    without_key = SessionBatch(active: 'passkey_Login', candidates: [])
    with_null = SessionBatch(
      active: 'passkey_Login',
      previous: null,
      candidates: []
    )
    expect(value: $without_key.previous, same: null)
    expect(value: $with_null.previous, same: null)
    expect(value: $with_null.active, same: $without_key.active)
  }

  test(name: 'a present optional key is subject to the same rules as a required one') {
    batch = SessionBatch(
      active: 'passkey_A',
      previous: ' passkey_B ',
      candidates: []
    )
    expect(value: $batch.previous, same: 'passkey_B')
    problems = SessionBatch->check({
      active: 'passkey_A',
      previous: 'bad',
      candidates: []
    })
    expect(value: $problems->pluck(path)->unique(), same: ['$.previous'])
  }

  test(name: 'invalid and null list items report their own indices') {
    input = {
      active: 'passkey_Login',
      candidates: ['passkey_A', 'passkey_A2', null]
    }
    problems = SessionBatch->check($input)
    expect(
      value: $problems->pluck(path)->unique(),
      same: ['$.candidates[1]', '$.candidates[2]']
    )
    expect(value: SessionBatch($input), throws: Shape)
  }

  test(name: 'a missing required array is distinct from an empty array') {
    input = '{"active":"passkey_Login"}'
    expect(value: $input->json(as: SessionBatch), throws: Shape)
    empty = '{"active":"passkey_Login","candidates":[]}'->json(as: SessionBatch)
    expect(value: $empty.candidates, same: [])
  }
}
