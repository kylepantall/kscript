import "extensions/calendar.kscript"
import "types/account.kscript"

extend Account {
  fn greeting(prefix: string = 'Hello') => "{$prefix}, {$this.name}!"
}

describe(name: 'Extension methods') {
  test(name: 'an imported method is available on a built-in date') {
    invoice_date = '2024-01-05'->to_date()
    expect($invoice_date->month_key(), same: '2024-01')
  }

  test(name: 'an extension can call another extension on both receivers') {
    first = '2024-12-01'->to_date()
    expect($first->shares_month('2024-12-31'->to_date()), same: true)
    expect($first->shares_month('2025-12-01'->to_date()), same: false)
  }

  test(name: 'a method added to a record reads the current instance') {
    ada = Account(name: 'Ada')
    lin = Account(name: 'Lin')
    expect($ada->greeting(), same: 'Hello, Ada!')
    expect($lin->greeting(prefix: 'Welcome'), same: 'Welcome, Lin!')
    expect($lin->label(), same: 'LIN')
  }
}
