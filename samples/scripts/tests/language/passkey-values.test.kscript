import "types/passkey-session-key.kscript"

fn session_key_for(kind: string) {
  session_key: PasskeySessionKey = "passkey_{$kind}"
  return $session_key
}

describe(name: 'Passkey session keys') {
  test(name: 'typed assignments accept both bare static keys and interpolated kinds') {
    static_key: PasskeySessionKey = passkey_login
    expect(value: @session_key_for('login'), same: $static_key)
    expect(value: @session_key_for('register'), same: 'passkey_register')
  }

  test(name: 'trimming outer whitespace leaves the case-sensitive suffix intact') {
    expect(value: PasskeySessionKey('  passkey_Login  '), same: 'passkey_Login')
    expect(value: PasskeySessionKey('  PASSKEY_Login  '), throws: Shape)
  }

  test(name: 'the shortest matching suffix has one letter') {
    expect(value: @session_key_for('a')->count(), same: 9)
    expect(value: @session_key_for(''), throws: Shape)
    expect(value: @session_key_for('123'), throws: Shape)
  }

  test(name: 'a valid prefix cannot hide a punctuation mark later in the suffix') {
    expect(value: @session_key_for('Login.Web'), throws: Shape)
    expect(value: @session_key_for('Login_'), throws: Shape)
  }

  test(name: 'only a trailing space is removed from the computed result') {
    expect(value: @session_key_for('login '), same: 'passkey_login')
    expect(value: @session_key_for(' login'), throws: Shape)
  }
}
