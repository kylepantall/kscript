import "types/login-name.kscript"

type PasskeySessionKey with [string] {
  min: 8
  normalize: @trim_key($value)
  pattern: /^passkey_[a-zA-Z]+$/

  fn trim_key(key: string) => $key->trim()
  fn break() => $value->count()
}

fn key_size(key: PasskeySessionKey) => $key->break()

test(name: 'a forward-declared helper sees the raw key before validation') {
  key = PasskeySessionKey('  passkey_Login  ')
  expect($key->to_string(), same: 'passkey_Login')
  expect($key->break(), equals: 13)
}

test(name: 'a typed function parameter normalizes its argument') {
  expect(@key_size(' passkey_Web '), equals: 11)
}

test(name: 'a cast keeps the methods of the refined value') {
  key = 'passkey_Test' as PasskeySessionKey
  expect(@key_size($key), equals: 12)
  expect($key->trim_key(' space '), equals: 'space')
}

test(name: 'the normalized key must still match its pattern') {
  expect(PasskeySessionKey('  passkey_123  '), throws: Shape)
  expect(PasskeySessionKey('     '), throws: Shape)
}

test(name: 'a lambda can name its own input and chain string methods') {
  name = LoginName('  JO  ')
  expect($name, same: 'jo')
}
