import "types/review-score.kscript"

type PassingScore with [ReviewScore] {
  min: 60
}

fn passing_scores(scores: ReviewScore[]) =>
  $scores->filter(->passes())

describe(name: 'Review score refinements') {
  test(name: 'both ends of the scale are valid and neighboring integers fail') {
    expect(ReviewScore('0')->passes(), same: false)
    expect(ReviewScore('100')->passes(), same: true)
    expect(ReviewScore(-1), throws: Shape)
    expect(ReviewScore(101), throws: Shape)
  }

  test(name: 'typed list parameters convert every score before filtering in order') {
    passed = @passing_scores(['59', 61, '60', 0, 61])
    expect(
      $passed->map(->to_number()),
      same: [61, 60, 61]
    )
    expect(@passing_scores([61, 'absent']), throws: Shape)
  }

  test(name: 'a narrower score keeps the base method and accepts the threshold') {
    pass: PassingScore = '60'
    expect($pass->passes(), same: true)
    expect($pass->to_number(), same: 60)
    expect(PassingScore(59), throws: Shape)
  }

  test(name: 'the outer refinement also enforces the upper bound inherited from the base') {
    expect(PassingScore(100)->passes(), same: true)
    expect(PassingScore(101), throws: Shape)
  }

  test(name: 'optional scores distinguish an absent grade from a failing zero') {
    absent = null as ReviewScore?
    zero = 0 as ReviewScore?
    expect($absent, same: null)
    expect($zero->passes(), same: false)
    expect('absent' as ReviewScore?, throws: Shape)
  }
}
