import "types/account.kscript"
import "types/seat-allocation.kscript"

type TeamAccount with [Account, SeatAllocation] {
  plan: string = 'team'

  fn label() => "{$this.name} ({$this.plan})"
}

fn remaining_seats(allocation: SeatAllocation) => $allocation->available()

describe(name: 'Team account composition') {
  test(name: 'a joined record supplies defaults from its base and its own declaration') {
    team = TeamAccount(name: 'Harbour', capacity: 4)
    expect($team.used, same: 0)
    expect($team.plan, same: 'team')
    expect($team->available(), same: 4)
  }

  test(name: 'the account overrides its label and inherits the allocation method') {
    team = TeamAccount(name: 'Harbour', capacity: 8, used: 3, plan: 'studio')
    expect($team->label(), same: 'Harbour (studio)')
    expect(@remaining_seats($team), same: 5)
    expect(Account(name: 'Harbour')->label(), same: 'HARBOUR')
  }

  test(name: 'both base types recognize a team while a plain account remains distinct') {
    team = TeamAccount(name: 'North', capacity: 2)
    expect(Account->is($team), same: true)
    expect(SeatAllocation->is(TeamAccount), same: true)
    expect(TeamAccount->is(Account(name: 'North')), same: false)
  }

  test(name: 'filling every seat still satisfies the inherited validation rule') {
    team = TeamAccount(name: 'West', capacity: 2, used: 1)
    team.used = 2
    expect(@remaining_seats($team), same: 0)
  }

  test(name: 'an overbooked account reports the inherited cross-field error') {
    data = { name: 'West', capacity: 2, used: 3 }
    problems = TeamAccount->check($data)
    expect($problems, count: 1)
    expect($problems[0].message, contains: 'Seat usage exceeds capacity')
    expect(TeamAccount($data), throws: Shape)
  }

  test(name: 'a rejected field update preserves the last valid allocation') {
    team = TeamAccount(name: 'West', capacity: 3, used: 2)
    expect_error(type: Shape) {
      team.used = 4
    }
    expect($team.used, same: 2)
    expect($team->available(), same: 1)
  }
}
