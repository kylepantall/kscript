import "../../errors/order-not-found.kscript"
import "../../errors/out-of-stock.kscript"
import "../../lib/strings.kscript" as words

fn order(id: int) {
  if $id < 1 {
    throw OrderNotFound(id: $id)
  }
  return @words.slugify('Order ' + $id)
}

test(name: 'a qualified import is callable inside a local function') {
  expect(@order(5), equals: 'order-5')
}

test(name: 'an imported error retains its fields and parent type') {
  expect_error(type: NotFound, as: err) {
    @order(0)
  }
  expect($err.type, equals: 'OrderNotFound')
  expect($err.status, same: 404)
  expect($err.message, equals: 'No order 0')
}

test(name: 'catch then finally run in order') {
  events = []
  try {
    @order(0)
  } catch OrderNotFound as err {
    events = $events->push($err.type)
  } finally {
    events = $events->push('finished')
  }
  expect($events, equals: ['OrderNotFound', 'finished'])
}

test(name: 'rethrowing a cause keeps the original error fields') {
  expect_error(type: Validation, as: outer) {
    try {
      @order(-1)
    } catch NotFound as inner {
      throw Validation(message: 'invalid order', cause: $inner)
    }
  }
  expect($outer.cause.type, same: 'OrderNotFound')
  expect($outer.cause.message, equals: 'No order -1')
}

test(name: 'named fields build a custom error independent of argument order') {
  expect_error(type: OutOfStock, as: err) {
    throw OutOfStock(wanted: 3, left: 1, item: 'tea')
  }
  expect($err.status, same: 409)
  expect($err.message, equals: 'Only 1 tea left, 3 wanted')
}
