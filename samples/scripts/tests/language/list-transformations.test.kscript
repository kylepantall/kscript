describe(name: "List transformations") {
  test(name: "grouping orders preserves the arrival order within each shop") {
    orders = [
      { shop: 'east', id: 17 },
      { shop: 'west', id: 8 },
      { shop: 'east', id: 11 },
    ]
    by_shop = $orders->group_by(.shop)
    expect($by_shop.east->pluck(id), same: [17, 11])
    expect($by_shop.west->pluck(id), same: [8])
  }

  test(name: "indexing stock updates by SKU retains the latest row for each item") {
    updates = [{ sku: 'A', qty: 3 }, { sku: 'B', qty: 7 }, { sku: 'A', qty: 0 }]
    latest = $updates->to_map(.sku)
    expect($latest['A'], same: { sku: 'A', qty: 0 })
    expect($latest['B'], same: { sku: 'B', qty: 7 })
    expect($latest->count(), same: 2)
  }

  test(name: "batching keeps a partial final page and flatten restores the original order") {
    ids = [4, 7, 9, 12, 15]
    pages = $ids->chunk(2)
    expect($pages, same: [[4, 7], [9, 12], [15]])
    expect($pages->flatten(), same: $ids)
    expect([]->chunk(2), same: [])
  }

  test(name: "zipping stops when either side runs out of values") {
    labels = ['high', 'medium', 'low']
    expect($labels->zip([5, 3]), same: [['high', 5], ['medium', 3]])
    expect([5, 3]->zip($labels), same: [[5, 'high'], [3, 'medium']])
    expect($labels->zip([]), same: [])
  }

  test(name: "a summary uses row weights and preserves an empty average") {
    lines = [{ qty: 4, price: 3 }, { qty: 2, price: 9 }]
    expect($lines->sum(fn(line) => $line.qty * $line.price), same: 30)
    expect($lines->average(.price), same: 6)
    expect([]->sum(), same: 0)
    expect([]->average(), same: null)
  }
}
