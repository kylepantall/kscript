type PageSpan {
  pattern: /^(?<first>\d+)\.\.(?<last>\d+)$/
  first: int(min: 1)
  last: int(min: 1)
  validate: $first <= $last, 'The first page must precede or equal the last'

  fn page_count() => $this.last - $this.first + 1
}

describe(name: 'Page spans read from text') {
  test(name: 'named captures convert digit strings to typed record fields') {
    pages = PageSpan('007..012')
    expect($pages.first, same: 7)
    expect($pages.last, same: 12)
    expect($pages->page_count(), same: 6)
  }

  test(name: 'a map and a printed span produce equivalent typed records') {
    from_map = PageSpan({ first: '3', last: '5' })
    from_text = '3..5' as PageSpan
    expect($from_map.first, same: $from_text.first)
    expect($from_map->page_count(), same: $from_text->page_count())
  }

  test(name: 'a one-page span includes its endpoint once') {
    pages: PageSpan = '1..1'
    expect($pages->page_count(), same: 1)
    expect(PageSpan->check('1..1'), count: 0)
  }

  test(name: 'text must match the entire page span grammar') {
    expect(PageSpan('3..5 pages'), throws: Shape)
    expect(PageSpan('3..'), throws: Shape)
  }

  test(name: 'well-formed text still has to pass field and cross-field validation') {
    expect(PageSpan('0..5'), throws: Shape)
    problems = PageSpan->check('6..5')
    expect($problems, count: 1)
    expect($problems[0].message, contains: 'first page')
  }
}
