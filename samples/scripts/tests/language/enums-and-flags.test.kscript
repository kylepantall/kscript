import "../../types/visibility.kscript" as access

enum DeliverySpeed { standard, express, overnight }

fn parcel_label(speed: DeliverySpeed, tracked: bool = true) =>
  $speed + ($tracked ? ' tracked' : ' untracked')

fn itinerary(speeds: DeliverySpeed[]) => $speeds->join(' then ')

fn access_label(level: string) => $level + ' access'

describe(name: 'Delivery choices') {
  test(name: 'an enum exposes its options and their declaration order') {
    expect(
      DeliverySpeed->keys(),
      equals: ['standard', 'express', 'overnight']
    )
    expect('express' in DeliverySpeed, same: true)
    expect('same-day' in DeliverySpeed, same: false)
  }

  test(name: 'bare values and explicit enum members select the same service') {
    expect(@parcel_label(express), same: 'express tracked')
    expect(@parcel_label(DeliverySpeed.express), same: 'express tracked')
  }

  test(name: 'an enum member from a named import can be passed to a function') {
    expect(
      @access_label(access.Visibility.public),
      same: 'public access'
    )
  }

  test(name: 'quoted input is converted to the spelling declared by the enum') {
    preference = 'OVERNIGHT'
    expect(@parcel_label($preference), same: 'overnight tracked')
  }

  test(name: 'a flag can enable or disable tracking independently of argument order') {
    expect(@parcel_label(tracked, standard), same: 'standard tracked')
    expect(
      @parcel_label(speed: standard, not tracked),
      same: 'standard untracked'
    )
  }

  test(name: 'a list parameter supplies enum context for each bare item') {
    expect(
      @itinerary([express, standard, overnight]),
      same: 'express then standard then overnight'
    )
    expect(@itinerary([]), same: '')
  }

  test(name: 'an unknown service from external text fails enum conversion') {
    preference = 'same-day'
    expect(@parcel_label($preference), throws: Argument)
  }
}
