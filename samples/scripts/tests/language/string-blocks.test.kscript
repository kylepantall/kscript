type PackingSlip {
  item: string
  qty: int
}

describe(name: "String interpolation and blocks") {
  test(name: "interpolation combines member access, arithmetic and a method call") {
    order = { sku: 'ab12', cartons: 2, pieces: 6 }
    label = "{$order.sku->upper()}: { $order.cartons * $order.pieces } pieces"
    expect(value: $label, same: 'AB12: 12 pieces')
  }

  test(name: "a route template keeps its argument braces beside interpolated text") {
    prefix = 'shops'
    template = '/shops/{id}'
    expect(value: "/{$prefix}/{{id}}", same: $template)
  }

  test(name: "a line continuation builds one sentence without indentation") {
    reader = 'Joan'
    greeting = "Hello {$reader}, \
      your order is ready."
    expect(value: $greeting, same: 'Hello Joan, your order is ready.')
  }

  test(name: "a fenced string retains indentation, blank lines and placeholder text") {
    notice = ```text
      Hello {name},

        Collection after 4
      ```
    expect(
      value: $notice->lines(),
      same: ['Hello {name},', '', '  Collection after 4']
    )
  }

  test(name: "a typed block checks and converts a packing slip as it is read") {
    slip = ```<PackingSlip>
      { "item": "Tea", "qty": "3" }
      ```
    expect(value: $slip.item, same: 'Tea')
    expect(value: $slip.qty, same: 3)
  }
}
