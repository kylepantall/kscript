type Till {
  balance: money(rates: { EUR: 0.80 })
}

fn post_credit(balance: money, credit: money) => $balance + $credit

describe(name: "Adding money with exchange rates") {
  test(name: "the incoming amount is converted into the balance's currency") {
    balance: money(rates: { EUR: 0.80 }) = 'GBP 1.00'
    change: money = 'EUR 0.75'
    expect(($balance + $change)->to_string(), same: 'GBP 1.60')
    expect($balance->add($change)->to_string(), same: 'GBP 1.60')
    expect($balance->to_string(), same: 'GBP 1.00')
    expect($change->add($balance), throws: Type)
  }

  test(name: "a one-off quote overrides the stored rate for one addition") {
    balance: money(rates: { EUR: 0.80 }) = 'GBP 1.00'
    euro: money = 'EUR 1.00'
    credited = $balance->add($euro, rate: 0.70)
    expect($credited->to_string(), same: 'GBP 1.70')
    expect($credited->add($euro)->to_string(), same: 'GBP 2.50')
  }

  test(name: "an ordinary balance accepts an explicit quote without sharing it") {
    balance: money = 'GBP 1.00'
    dollar: money = 'USD 2.00'
    result = $balance->add($dollar, rate: 0.75)
    expect($result->to_string(), same: 'GBP 2.50')
    expect($result->add($dollar), throws: Type)
  }

  test(name: "same-currency additions work and missing rates are reported") {
    balance: money(rates: { EUR: 0.80 }) = 'GBP 1.00'
    pound: money = 'GBP 1.00'
    dollar: money = 'USD 1.00'
    expect(($balance + $pound)->to_string(), same: 'GBP 2.00')
    expect($pound->add($pound)->to_string(), same: 'GBP 2.00')
    expect($balance->add($dollar), throws: Type)
    expect($pound->add($dollar), throws: Type)
  }

  test(name: "conversion rounds each incoming adjustment to the receiving minor unit") {
    balance: money(rates: { USD: 0.005 }) = 'GBP 1.00'
    debit: money = 'USD -1.00'
    credit: money = 'USD 1.00'
    expect($balance->add($debit)->to_string(), same: 'GBP 0.99')
    expect($balance->add($credit)->to_string(), same: 'GBP 1.01')
    yen: money = 'JPY 100'
    expect(
      $yen->add($credit, rate: 150.50)->to_string(),
      same: 'JPY 251'
    )
  }

  test(name: "a configured record field supplies the same rate after splitting a balance") {
    till = Till(balance: 'GBP 3.00')
    parts = $till.balance->split(2)
    euro: money = 'EUR 1.00'
    expect($parts[0]->add($euro)->to_string(), same: 'GBP 2.30')
  }

  test(name: "two tills can use independent quotes for the same currency") {
    morning: money(rates: { EUR: 0.80 }) = 'GBP 0.00'
    afternoon: money(rates: { EUR: 0.90 }) = 'GBP 0.00'
    euro: money = 'EUR 1.00'
    expect($morning->add($euro)->to_string(), same: 'GBP 0.80')
    expect($afternoon->add($euro)->to_string(), same: 'GBP 0.90')
  }

  test(name: "a list total uses the first amount as the receiving balance") {
    balance: money(rates: { EUR: 0.80 }) = 'GBP 1.00'
    euro: money = 'EUR 1.00'
    mixed: money[] = [$balance, $euro, $euro]
    expect($mixed->total()->to_string(), same: 'GBP 2.60')
    expect($mixed->reverse()->total(), throws: Type)
    local: money[] = [$balance, 'GBP 0.25']
    expect($local->total()->to_string(), same: 'GBP 1.25')
  }

  test(name: "registered rates apply to existing values and can be updated") {
    balance: money = 'CAD 1.00'
    credit: money = 'CHF 2.00'
    @set_exchange_rate(from: 'CHF', to: 'CAD', rate: 1.50)
    expect(
      @post_credit($balance, $credit)->to_string(),
      same: 'CAD 4.00'
    )
    @set_exchange_rate(from: 'CHF', to: 'CAD', rate: 1.60)
    expect($balance->add($credit)->to_string(), same: 'CAD 4.20')
    amounts: money[] = [$balance, $credit]
    expect($amounts->total()->to_string(), same: 'CAD 4.20')

    quoted: money(rates: { CHF: 1.75 }) = 'CAD 1.00'
    expect(($quoted + $credit)->to_string(), same: 'CAD 4.50')
    expect($quoted->add($credit, rate: 2)->to_string(), same: 'CAD 5.00')
    expect($credit + $balance, throws: Type)
  }

  test(name: "two quoted exchange pairs do not imply a third pair") {
    @set_exchange_rate(from: 'AUD', to: 'NZD', rate: 1.10)
    @set_exchange_rate(from: 'NZD', to: 'JPY', rate: 100)
    balance: money = 'JPY 100'
    incoming: money = 'AUD 1'
    expect($balance + $incoming, throws: Type)
  }

  test(name: "a quote too precise for money arithmetic is rejected") {
    balance: money = 'GBP 0'
    incoming: money = 'USD 10000000000000000000000000000'
    tiny_quote = 0.00000000000000000000000000006
    expect($balance->add($incoming, rate: $tiny_quote), throws: Argument)
  }
}
