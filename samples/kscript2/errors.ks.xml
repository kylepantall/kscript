<kscript>
  <!-- Error types: declare them, throw them with their fields, and catch them by type. -->

  <error
    name="OrderNotFound"
    message="No order {$id}"
    description="An order that can't be found."
    extends="NotFound">
    <field name="id" type="int" />
  </error>

  <error
    name="OutOfStock"
    status="409"
    message="Only {$left} {$item} left, {$wanted} wanted"
    description="Not enough of something in stock.">
    <field name="item" type="string" />
    <field name="left" type="int" />
    <field name="wanted" type="int" />
  </error>

  <let name="stock" value="{ tea: 2, coffee: 10 }" />
  <let
    name="orders"
    value="[{ id: 1, item: 'tea', qty: 5 }, { id: 2, item: 'coffee', qty: 1 }]" />

  <fn name="place" params="id: int">
    <let name="order" value="$orders->find(fn($o) => $o.id == $id)" />
    <if $order == null>
      <throw value="OrderNotFound(id: $id)" />
    </if>
    <let name="left" value="$stock[$order.item]" />
    <if $left < $order.qty>
      <throw value="OutOfStock(item: $order.item, left: $left, wanted: $order.qty)" />
    </if>
    <return value="'Order ' + $id + ': ' + $order.qty + ' ' + $order.item" />
  </fn>

  <for each="id" in="[1, 2, 3]">
    <try>
      <echo value="@place($id)" />
      <catch type="OutOfStock" as="e">
        <echo>{ $e.message } ({ $e.status })</echo>
      </catch>
      <catch type="NotFound" as="e">
        <echo>{ $e.message } ({ $e.type }, { $e.status })</echo>
      </catch>
    </try>
  </for>

  <try>
    <try>
      <do>@place(3)</do>
      <catch as="err">
        <throw value="Validation(message: &quot;Couldn't place the order&quot;, cause: $err)" />
      </catch>
    </try>
    <catch type="Validation" as="e">
      <echo>{ $e.message }: { $e.cause.message }</echo>
    </catch>
  </try>
</kscript>
