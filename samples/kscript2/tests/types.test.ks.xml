<kscript>
  <import package="KScript.IO" />
  <import src="../types/repo.ks.xml" />

  <describe name="Repo">
    <test name="maps the saved response">
      <let name="repos" value="@read_json('../data/repos.json', as: Repo)" />
      <expect value="$repos->count()" equals="2" />
      <expect value="$repos[0].stars" equals="12" />
      <expect value="$repos[0].license" equals="'MIT License'" />
      <expect value="$repos[1].license" equals="null" />
      <expect value="$repos[0]->type()" equals="'Repo'" />
    </test>

    <test name="reports every problem">
      <expect
        value="$Repo->check({ stargazers_count: 'lots' })->count()"
        equals="5" />
    </test>
  </describe>
</kscript>
