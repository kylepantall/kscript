import KScript.Document

// A short scientific paper: maths, a figure, a table from data, citations and footnotes.
// kscript paper.kscript writes paper.pdf, paper.docx and paper.tex next to this file.

patterns = [
  { name: 'Glider', period: 4, speed: 'c/4', cells: 5 },
  { name: 'Lightweight spaceship', period: 4, speed: 'c/2', cells: 9 },
  { name: 'Blinker', period: 2, speed: '0', cells: 3 },
  { name: 'Pulsar', period: 3, speed: '0', cells: 48 },
]

KScript.Document(template: paper, title: "How Gliders Move", subtitle: "A note on Conway's Game of Life", date: "20 November 2026", keywords: "cellular automata, Game of Life", to: "paper.pdf, paper.docx, paper.tex") {
  Author(affiliation: "Department of Computing, Example University", email: "ada@example.org") "Ada Lovelace"
  Author(affiliation: "Institute of Patterns") "Alan Turing"

  Abstract "We describe the glider, the smallest pattern in Conway's Game of Life that travels. It returns to its own shape every \( p = 4 \) generations, moved one cell diagonally, so its speed is \( c/4 \). We compare it with other small patterns and give the rule as a formula."

  Section(title: Introduction, id: intro) {
    Paragraph "The Game of Life [@gardner1970] is a cellular automaton on a square grid. Each cell is alive or dead, and the next generation depends only on the eight neighbours of each cell.^[The grid is usually taken to be infinite.] Despite the simple rule, Life can compute anything a computer can [@berlekamp1982; @wolfram1984]."

    Paragraph "Section [#rule] gives the rule, Figure [#fig-glider] shows a glider over four generations and Table [#tab-patterns] lists some well-known patterns."
  }

  Section(title: The rule, id: rule) {
    Paragraph "Let \( N_t(x) \) be the number of live neighbours of cell \( x \) at time \( t \). A cell is alive at time \( t + 1 \) when"

    Math(id: eq-rule) "s_{t+1}(x) = \begin{cases} 1 & \text{if } N_t(x) = 3, \\\\ 1 & \text{if } s_t(x) = 1 \text{ and } N_t(x) = 2, \\\\ 0 & \text{otherwise.} \end{cases}"

    Paragraph "Equation [#eq-rule] is applied to every cell at once. The neighbour count is a sum over the Moore neighbourhood \( \mathcal{M}(x) = \{ y \in \mathbb{Z}^2 : 0 < \lVert y - x \rVert_\infty \le 1 \} \):"

    Math(id: eq-count) "N_t(x) = \sum_{y \in \mathcal{M}(x)} s_t(y)"
  }

  Section(title: Gliders) {
    Figure(src: "glider.png", caption: "A glider over four generations: after \( p = 4 \) steps it has moved one cell down and to the right.", id: fig-glider, width: 0.8)

    Paragraph "A pattern with period \( p \) that moves \( (\Delta x, \Delta y) \) cells has speed"

    Math(id: eq-speed) "v = \frac{\max(|\Delta x|, |\Delta y|)}{p} \, c"

    Paragraph "where \( c \) is one cell per generation, the fastest any signal can travel. For the glider, \( \Delta x = \Delta y = 1 \) and \( p = 4 \), so \( v = c/4 \)."

    Table(caption: "Some small patterns and their periods.", id: tab-patterns, data: $patterns, columns: { Pattern: 'name', Period: 'period', Speed: 'speed', Cells: 'cells' }, align: "lrrr")

    Section(title: Population) {
      Paragraph "The population of a glider is always 5. Across all phases the mean density in its \( 3 \times 3 \) bounding box is \( \tfrac{5}{9} \approx 0.56 \)."
    }
  }

  Section(title: Conclusion) {
    List {
      Item "Gliders are the smallest moving pattern, with **5 cells**."
      Item "Their speed, \( c/4 \), is the fastest possible for a diagonal mover."
      Item "Glider streams carry signals, which is how Life computes [@berlekamp1982]."
    }
  }

  Bibliography(src: "refs.bib")
}
