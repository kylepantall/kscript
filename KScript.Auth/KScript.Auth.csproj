<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript.Auth</RootNamespace>
    <AssemblyName>KScript.Auth</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>KScript.Auth: sign-in for kscript serve apps: users, sessions, CSRF, password resets and API tokens.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KScript.Tests" />
    <InternalsVisibleTo Include="KScript.Http" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Sources\ownable.kscript" LogicalName="KScript.Auth.Sources.ownable.kscript" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fido2" Version="4.3.3" />
    <ProjectReference Include="..\KScript.Core\KScript.Core.csproj" />
    <ProjectReference Include="..\KScript.Data\KScript.Data.csproj" />
  </ItemGroup>

</Project>
