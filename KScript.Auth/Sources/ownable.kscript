import KScript.Data
import KScript.Auth

/// Rows that belong to one owner: the signed-in user, or the browser's guest. A model that extends Ownable
/// gets a user and a guest, one of them filled in from who is making a record and never changed after, the
/// mine() scope and ->is_mine(). To change them, publish your own copy with kscript publish Ownable.
model Ownable(mixin, guarded: [user, guest]) {
  /// The user the record belongs to, or null when a guest made it.
  user?: User

  /// The guest the record belongs to, or null when a signed-in user made it.
  guest?: Guest

  /// Keeps the current owner's rows. Outside a request (a test, job or script), name the user:
  /// ->mine(as: $user).
  fn mine(query, as: any = null) {
    owner = $as ?? @user()
    if $owner != null {
      return $query->where(user: $owner)
    }
    visitor = @guest()
    guard $visitor != null else {
      throw Unauthorized "->mine() needs someone signed in, or a guest. Outside a request, name the user, such as ->mine(as: the user)."
    }
    return $query->where(guest: $visitor)
  }

  /// True when the record belongs to whoever is making the request.
  fn is_mine() {
    me = @user()
    if $me != null {
      return $this.user != null and $this.user->is($me)
    }
    visitor = @guest()
    return $visitor != null and $this.guest != null and $this.guest->is($visitor)
  }
}
