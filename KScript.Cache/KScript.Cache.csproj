<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript.Caching</RootNamespace>
    <AssemblyName>KScript.Cache</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>KScript.Cache: a memory and file cache with keys and time limits.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KScript.Tests" />
    <InternalsVisibleTo Include="KScript.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KScript.Core\KScript.Core.csproj" />
    <ProjectReference Include="..\KScript.Storage\KScript.Storage.csproj" />
  </ItemGroup>

</Project>
