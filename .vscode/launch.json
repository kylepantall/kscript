{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run KScript",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/KScriptApp/bin/Debug/net8.0/KScript.dll",
            "args": [ "${input:filePath}" ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ],
    "inputs": [
        {
            "id": "filePath",
            "description": "Enter a KScript file path to run: ",
            "default": "DebugScripts/Debug.xml",
            "type": "promptString"
        }
    ]
}
