{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "problemMatcher": "$msCompile",
            "args": [ "build", "${workspaceFolder}/KScript.sln" ],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "problemMatcher": "$msCompile",
            "args": [ "test", "${workspaceFolder}/KScript.sln" ],
            "group": "test"
        },
        {
            "label": "build_release",
            "command": "dotnet",
            "type": "process",
            "problemMatcher": "$msCompile",
            "args": [ "build", "${workspaceFolder}/KScript.sln", "--configuration", "Release" ]
        }
    ]
}
