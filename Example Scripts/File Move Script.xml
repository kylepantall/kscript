<kscript>
  <import package="KScript.Terminal" />
  <import package="KScript.IO" />

  <picker to="old_dir">Move files from: </picker>
  <picker to="new_dir">Move files to: </picker>
  <input to="file_types">File types (comma separated, such as txt, pdf): </input>

  <let
    name="types"
    value="$file_types->split(',')->map(fn($t) => $t->trim()->trim_start('.'))" />
  <for
    each="file"
    in="@files($old_dir) |> filter(fn($f) => $types->contains($f->extension()))">
    <let name="target" value="@join_path(base: $new_dir, $file->name())" />
    <do>@move($file, $target)</do>
    <echo>Moved {$file->name()} to {$target}</echo>
  </for>
</kscript>
