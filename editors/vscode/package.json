{
  "name": "kscript",
  "displayName": "KScript",
  "description": "KScript language support: errors as you type, completion, hover, go to definition, rename and quick fixes for scripts and kscript serve pages.",
  "version": "0.1.0",
  "publisher": "kylepantall",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylepantall/kscript"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:kscript",
    "onLanguage:kscript-code",
    "workspaceContains:**/_components/*.html",
    "workspaceContains:**/_layout.html",
    "workspaceContains:**/kscript.json"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kscript",
        "aliases": [
          "KScript",
          "kscript"
        ],
        "extensions": [
          ".ks.xml",
          ".ks"
        ],
        "icon": {
          "light": "./icons/kscript-light.svg",
          "dark": "./icons/kscript-dark.svg"
        },
        "firstLine": "^\\s*(<\\?xml[^>]*>\\s*)?<kscript\\b",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "kscript-code",
        "aliases": [
          "KScript (code)"
        ],
        "extensions": [
          ".kscript"
        ],
        "icon": {
          "light": "./icons/kscript-light.svg",
          "dark": "./icons/kscript-dark.svg"
        },
        "configuration": "./language-configuration-code.json"
      },
      {
        "id": "jsonc",
        "filenames": [
          "kscript.json",
          "kscript-standard.json"
        ],
        "filenamePatterns": [
          "*.kscript-standard.json"
        ]
      }
    ],
    "grammars": [
      {
        "language": "kscript",
        "scopeName": "source.kscript",
        "path": "./syntaxes/kscript.tmLanguage.json"
      },
      {
        "language": "kscript-code",
        "scopeName": "source.kscript-code",
        "path": "./syntaxes/kscript-code.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.html": "html",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.markdown": "markdown",
          "meta.embedded.block.latex": "latex",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.xml": "xml"
        }
      },
      {
        "scopeName": "kscript.pages.injection",
        "path": "./syntaxes/kscript-pages.injection.json",
        "injectTo": [
          "text.html.derivative",
          "text.html.basic",
          "text.html.markdown"
        ]
      }
    ],
    "configuration": {
      "title": "KScript",
      "properties": {
        "kscript.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `kscript` executable that runs the language server. Leave empty to use the installed KScript (`~/.kscript/bin`, `%LOCALAPPDATA%\\Programs\\kscript`, then your `PATH`). A `KScript.dll` from a source build also works (run with `dotnet`). `~` and `${env:NAME}` are expanded."
        },
        "kscript.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "markdownDescription": "Arguments that start the language server."
        },
        "kscript.pages.enabled": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Check .html and .md files in folders that look like a kscript serve site (_components/, _layout.html, _layouts/ or kscript.json).",
            "Always check .html and .md files.",
            "Only check KScript scripts."
          ],
          "markdownDescription": "Check KScript in `.html` and `.md` pages (sites run with `kscript serve`)."
        },
        "kscript.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the language server."
        },
        "kscript.autoCloseTags": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Add the end tag when you finish typing a start tag in a `.ks.xml` script: `<echo>` becomes `<echo></echo>`."
        },
        "kscript.blocks.dividers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Draw a thin line between the top-level blocks of a script (functions, loops and comment-headed sections), like cells in a notebook."
        },
        "kscript.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show **Run** above a script, **Run test** above each test and how many times each function is used."
        }
      }
    },
    "commands": [
      {
        "command": "kscript.onEnter",
        "title": "Enter (ends an empty /// comment)",
        "category": "KScript"
      },
      {
        "command": "kscript.restartServer",
        "title": "Restart Language Server",
        "category": "KScript"
      },
      {
        "command": "kscript.showOutput",
        "title": "Show Language Server Output",
        "category": "KScript"
      },
      {
        "command": "kscript.run",
        "title": "Run Script",
        "category": "KScript",
        "icon": "$(play)"
      },
      {
        "command": "kscript.runTests",
        "title": "Run Tests",
        "category": "KScript"
      },
      {
        "command": "kscript.runTestsInFile",
        "title": "Run Tests in This File",
        "category": "KScript",
        "icon": "$(beaker)"
      },
      {
        "command": "kscript.runTest",
        "title": "Run Test",
        "category": "KScript"
      },
      {
        "command": "kscript.serve",
        "title": "Serve Site",
        "category": "KScript"
      },
      {
        "command": "kscript.check",
        "title": "Check Project",
        "category": "KScript"
      },
      {
        "command": "kscript.formatProject",
        "title": "Format Project",
        "category": "KScript"
      },
      {
        "command": "kscript.newScript",
        "title": "New Script",
        "category": "KScript"
      },
      {
        "command": "kscript.newProject",
        "title": "New Project…",
        "category": "KScript"
      },
      {
        "command": "kscript.openDocs",
        "title": "Open Docs",
        "category": "KScript"
      },
      {
        "command": "kscript.showReferences",
        "title": "Show Uses",
        "category": "KScript"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "kscript.json",
        "url": "./schemas/kscript.schema.json"
      },
      {
        "fileMatch": [
          "kscript-standard.json",
          "*.kscript-standard.json"
        ],
        "url": "./schemas/kscript-standard.schema.json"
      }
    ],
    "keybindings": [
      {
        "key": "enter",
        "command": "kscript.onEnter",
        "when": "editorTextFocus && editorLangId == kscript-code && !editorReadonly && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && vim.mode != 'Normal' && vim.mode != 'Visual' && vim.mode != 'VisualLine' && vim.mode != 'VisualBlock'"
      },
      {
        "key": "f5",
        "command": "kscript.run",
        "when": "editorTextFocus && (editorLangId == kscript || editorLangId == kscript-code) && !inDebugMode"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "kscript.newScript",
          "group": "file"
        }
      ],
      "editor/title/run": [
        {
          "command": "kscript.run",
          "when": "(editorLangId == kscript || editorLangId == kscript-code) && !(resourceFilename =~ /\\.test\\.((ks\\.)?xml|kscript)$/)",
          "group": "navigation"
        },
        {
          "command": "kscript.runTestsInFile",
          "when": "resourceFilename =~ /\\.test\\.((ks\\.)?xml|kscript)$/",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "kscript.onEnter",
          "when": "false"
        },
        {
          "command": "kscript.runTest",
          "when": "false"
        },
        {
          "command": "kscript.showReferences",
          "when": "false"
        },
        {
          "command": "kscript.run",
          "when": "(editorLangId == kscript || editorLangId == kscript-code)"
        },
        {
          "command": "kscript.runTestsInFile",
          "when": "resourceFilename =~ /\\.test\\.((ks\\.)?xml|kscript)$/"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "kscript",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "test",
              "serve",
              "check",
              "fmt",
              "docs",
              "make"
            ],
            "description": "The kscript command to run."
          },
          "file": {
            "type": "string",
            "description": "The script to run, or a test file to run instead of every test in the folder."
          }
        }
      }
    ],
    "configurationDefaults": {
      "[kscript]": {
        "editor.defaultFormatter": "kylepantall.kscript",
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.suggest.showStatusBar": true,
        "editor.wordBasedSuggestions": "off",
        "editor.snippetSuggestions": "none",
        "editor.suggest.showWords": false,
        "editor.suggest.showSnippets": false
      },
      "[kscript-code]": {
        "editor.defaultFormatter": "kylepantall.kscript",
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        },
        "editor.suggest.showStatusBar": true,
        "editor.wordBasedSuggestions": "off",
        "editor.snippetSuggestions": "none",
        "editor.suggest.showWords": false,
        "editor.suggest.showSnippets": false
      }
    },
    "semanticTokenScopes": [
      {
        "language": "kscript",
        "scopes": {
          "type": [
            "support.type.kscript"
          ],
          "variable.readonly": [
            "variable.other.constant.kscript"
          ],
          "parameter": [
            "variable.parameter.kscript"
          ],
          "property": [
            "variable.other.property.kscript"
          ],
          "method.defaultLibrary": [
            "support.function.kscript"
          ],
          "function.defaultLibrary": [
            "support.function.kscript"
          ]
        }
      },
      {
        "language": "kscript-code",
        "scopes": {
          "type": [
            "support.type.kscript"
          ],
          "variable.readonly": [
            "variable.other.constant.kscript"
          ],
          "parameter": [
            "variable.parameter.kscript"
          ],
          "property": [
            "variable.other.property.kscript"
          ],
          "method.defaultLibrary": [
            "support.function.kscript"
          ],
          "function.defaultLibrary": [
            "support.function.kscript"
          ]
        }
      }
    ],
    "colors": [
      {
        "id": "kscript.blockDivider",
        "description": "The line drawn between the top-level blocks of a KScript script.",
        "defaults": {
          "dark": "#ffffff26",
          "light": "#0000001f",
          "highContrast": "contrastBorder",
          "highContrastLight": "contrastBorder"
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get Started with KScript",
        "description": "Write your first script, run it, and see how the editor helps.",
        "steps": [
          {
            "id": "install",
            "title": "Install KScript",
            "description": "The editor uses the kscript command for errors, suggestions and running scripts.\n[Open the Install Guide](command:kscript.showSetup)",
            "media": { "markdown": "walkthrough/install.md" },
            "completionEvents": ["onCommand:kscript.showSetup", "onCommand:kscript.run"]
          },
          {
            "id": "newScript",
            "title": "Write your first script",
            "description": "Open a short script that is ready to run.\n[New Script](command:kscript.newScript)",
            "media": { "markdown": "walkthrough/first-script.md" },
            "completionEvents": ["onCommand:kscript.newScript"]
          },
          {
            "id": "run",
            "title": "Run it",
            "description": "Run the script you have open and see what it prints.\n[Run Script](command:kscript.run)",
            "media": { "markdown": "walkthrough/run.md" },
            "completionEvents": ["onCommand:kscript.run"]
          },
          {
            "id": "mistakes",
            "title": "Fix a mistake",
            "description": "Mistakes are underlined as you type, and most come with a fix you can pick.",
            "media": { "markdown": "walkthrough/mistakes.md" }
          },
          {
            "id": "explore",
            "title": "Find out what you can write",
            "description": "Suggestions and hovers show what is there. The docs have the rest.\n[Open Docs](command:kscript.openDocs)",
            "media": { "markdown": "walkthrough/explore.md" },
            "completionEvents": ["onCommand:kscript.openDocs"]
          },
          {
            "id": "project",
            "title": "Start a project",
            "description": "Keep scripts, tests and settings together in one folder.\n[New Project…](command:kscript.newProject)",
            "media": { "markdown": "walkthrough/project.md" },
            "completionEvents": ["onCommand:kscript.newProject"]
          }
        ]
      }
    ],
    "problemMatchers": [
      {
        "name": "kscript-run",
        "label": "KScript: the error a script stopped with",
        "owner": "kscript-run",
        "source": "kscript",
        "applyTo": "allDocuments",
        "fileLocation": "absolute",
        "severity": "error",
        "pattern": {
          "regexp": "ERROR\\s+(?:\\u001b\\[[0-9;]*m\\s*)?(.+?):(\\d+):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      },
      {
        "name": "kscript-check",
        "label": "KScript: problems found by kscript check",
        "owner": "kscript-check",
        "source": "kscript",
        "applyTo": "allDocuments",
        "fileLocation": [
          "autoDetect",
          "${cwd}"
        ],
        "pattern": {
          "regexp": "^(.+)\\((\\d+),(\\d+)\\): (error|warning|info) (KS\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js && node --check src/server.js && node --check src/site.js && node --check src/blocks.js && node --check src/watch.js && node --check src/comments.js && node --check src/autoclose.js && node --check src/run.js && node --check src/commands.js && node --check src/starter.js && node --check src/testing.js",
    "test": "node --test test/unit/*.test.js",
    "smoke": "node test/smoke.js",
    "package": "vsce package --no-dependencies --skip-license -o kscript-vscode.vsix",
    "bundle": "esbuild extension.js --bundle --platform=node --target=node18 --format=cjs --external:vscode --outfile=dist/extension.js --minify --sourcemap",
    "vscode:prepublish": "npm run bundle",
    "test:vscode": "npm run bundle && node test/integration/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "icon": "icon.png",
  "homepage": "https://github.com/kylepantall/kscript#readme",
  "bugs": {
    "url": "https://github.com/kylepantall/kscript/issues"
  },
  "keywords": [
    "kscript",
    "xml",
    "scripting",
    "lsp",
    "language server"
  ],
  "galleryBanner": {
    "color": "#2563eb",
    "theme": "dark"
  }
}
