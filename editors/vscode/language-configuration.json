{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<!--", "-->"],
    ["<", ">"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "<!--", "close": " -->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [
    { "open": "'", "close": "'" },
    { "open": "\"", "close": "\"" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "<", "close": ">" }
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|;\\:\\'\\\"\\,\\.\\<\\>\\/\\s]+)",
  "folding": {
    "markers": {
      "start": "^\\s*<(?!/)(?!.*/>)[^>]*>\\s*$",
      "end": "^\\s*</"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "<([_:\\w][_:\\w\\-.\\d]*)([^/>]*(?!/)>)[^<]*$",
      "afterText": "^</([_:\\w][_:\\w\\-.\\d]*)\\s*>",
      "action": { "indent": "indentOutdent" }
    }
  ]
}
