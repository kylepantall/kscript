{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KScript",
  "scopeName": "source.kscript",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#cdata"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#json-block"
    },
    {
      "include": "#tag-shorthand"
    },
    {
      "include": "#tag-control"
    },
    {
      "include": "#tag-declaration"
    },
    {
      "include": "#tag"
    },
    {
      "include": "#entity"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#bare-reference"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.kscript",
          "comment": "<!--- ... --> documents the element after it, like /// in a .kscript file. Tags count at the start of a line.",
          "begin": "<!---(?!-)",
          "end": "-->",
          "patterns": [
            {
              "match": "(?:^|\\G)\\s*(@(?:param|argument|arg))\\s+(\\$?[A-Za-z_][\\w-]*)",
              "captures": {
                "1": {
                  "name": "storage.type.class.doc.kscript"
                },
                "2": {
                  "name": "variable.parameter.kscript"
                }
              }
            },
            {
              "match": "(?:^|\\G)\\s*(@(?:returns?|example|deprecated|see|public|llm|prefer|avoid|pitfall|agent|param|argument|arg))(?![\\w-])",
              "captures": {
                "1": {
                  "name": "storage.type.class.doc.kscript"
                }
              }
            },
            {
              "match": "`[^`]*`",
              "name": "markup.inline.raw.kscript"
            }
          ]
        },
        {
          "name": "comment.block.kscript",
          "begin": "<!--",
          "end": "-->"
        }
      ]
    },
    "cdata": {
      "name": "string.unquoted.cdata.kscript",
      "begin": "<!\\[CDATA\\[",
      "end": "]]>"
    },
    "declaration": {
      "name": "meta.tag.preprocessor.kscript",
      "begin": "<\\?",
      "end": "\\?>"
    },
    "entity": {
      "name": "constant.character.entity.kscript",
      "match": "&(?:[A-Za-z]+|#\\d+|#x[0-9A-Fa-f]+);"
    },
    "tag": {
      "begin": "(</?)([A-Za-z_][\\w.:-]*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        },
        "2": {
          "name": "entity.name.tag.kscript"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        }
      },
      "name": "meta.tag.kscript",
      "patterns": [
        {
          "match": "\\b([A-Za-z_][\\w.:-]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.kscript"
            },
            "2": {
              "name": "punctuation.separator.key-value.kscript"
            }
          }
        },
        {
          "include": "#attribute-value-double"
        },
        {
          "include": "#attribute-value-single"
        }
      ]
    },
    "attribute-value-double": {
      "name": "meta.attribute-value.kscript",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kscript"
        }
      },
      "patterns": [
        {
          "include": "#entity"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#typed-literals"
        },
        {
          "include": "#strings"
        },
        {
          "name": "constant.numeric.kscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.kscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        },
        {
          "name": "keyword.operator.word.kscript",
          "match": "\\b(and|or|not|eq|ne|lt|le|gt|ge|in|step)\\b"
        },
        {
          "name": "storage.type.function.kscript",
          "match": "\\b(fn|match)\\b"
        },
        {
          "name": "constant.language.kscript",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.kscript",
          "match": "\\|>|=>|===|!==|==|!=|\\?\\?=?|\\?\\.|\\.\\.|\\*\\*|[-+*/%]=?|>=?|\\?|:"
        }
      ]
    },
    "attribute-value-single": {
      "name": "meta.attribute-value.kscript",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kscript"
        }
      },
      "patterns": [
        {
          "include": "#entity"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#typed-literals"
        },
        {
          "name": "constant.numeric.kscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.kscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        },
        {
          "name": "keyword.operator.word.kscript",
          "match": "\\b(and|or|not|eq|ne|lt|le|gt|ge|in|step)\\b"
        },
        {
          "name": "storage.type.function.kscript",
          "match": "\\b(fn|match)\\b"
        },
        {
          "name": "constant.language.kscript",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.kscript",
          "match": "\\|>|=>|===|!==|==|!=|\\?\\?=?|\\?\\.|\\.\\.|\\*\\*|[-+*/%]=?|>=?|\\?|:"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.kscript",
          "match": "'[^']*'"
        },
        {
          "name": "string.quoted.double.kscript",
          "match": "\"[^\"]*\""
        }
      ]
    },
    "interpolation": {
      "name": "meta.embedded.expression.kscript",
      "begin": "\\{!?(?!\\{)",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.kscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.kscript"
        }
      },
      "patterns": [
        {
          "include": "#map-literal"
        },
        {
          "include": "#typed-literals"
        },
        {
          "include": "#strings"
        },
        {
          "name": "constant.numeric.kscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.kscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        },
        {
          "name": "keyword.operator.word.kscript",
          "match": "\\b(and|or|not|eq|ne|lt|le|gt|ge|in|step)\\b"
        },
        {
          "name": "storage.type.function.kscript",
          "match": "\\b(fn|match)\\b"
        },
        {
          "name": "constant.language.kscript",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.kscript",
          "match": "\\|>|=>|===|!==|==|!=|\\?\\?=?|\\?\\.|\\.\\.|\\*\\*|[-+*/%]=?|>=?|\\?|:"
        }
      ]
    },
    "map-literal": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#map-literal"
        },
        {
          "include": "#strings"
        },
        {
          "name": "constant.numeric.kscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.kscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        },
        {
          "name": "keyword.operator.word.kscript",
          "match": "\\b(and|or|not|eq|ne|lt|le|gt|ge|in|step)\\b"
        },
        {
          "name": "storage.type.function.kscript",
          "match": "\\b(fn|match)\\b"
        },
        {
          "name": "constant.language.kscript",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.kscript",
          "match": "\\|>|=>|===|!==|==|!=|\\?\\?=?|\\?\\.|\\.\\.|\\*\\*|[-+*/%]=?|>=?|\\?|:"
        }
      ]
    },
    "bare-reference": {
      "patterns": [
        {
          "match": "(\\$[A-Za-z_][A-Za-z0-9_]*)((?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "variable.other.kscript"
            },
            "2": {
              "name": "variable.other.property.kscript"
            }
          }
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "(?<![\\w.])@[A-Za-z_][A-Za-z0-9_]*(?=\\()"
        },
        {
          "match": "(->)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        }
      ]
    },
    "tag-shorthand": {
      "comment": "<if $ready>, <while $n lt 3>, <match $choice>, <assert $total eq 30 />: the start tag holds the expression itself (it means test=\"...\", or value=\"...\" for match). A '>' with a space on both sides and more after it on the line is the greater-than operator, as in KScript's parser.",
      "begin": "(<)(if|elif|while|match|assert)(?=\\s+(?![A-Za-z_][\\w.:-]*\\s*=(?![=>]))(?!/?>))",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        },
        "2": {
          "name": "keyword.control.flow.kscript entity.name.tag.kscript"
        }
      },
      "end": "(?<![-=])((?<=\\s)>(?![ \\t]+[^\\s<])(?!=)|(?<!\\s)/?>(?!=)|/>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        }
      },
      "name": "meta.tag.kscript",
      "contentName": "meta.embedded.expression.kscript",
      "patterns": [
        {
          "include": "#entity"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#strings"
        },
        {
          "name": "constant.numeric.kscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.kscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        },
        {
          "name": "keyword.operator.word.kscript",
          "match": "\\b(and|or|not|eq|ne|lt|le|gt|ge|in|step)\\b"
        },
        {
          "name": "storage.type.function.kscript",
          "match": "\\b(fn|match)\\b"
        },
        {
          "name": "constant.language.kscript",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.kscript",
          "match": "\\|>|=>|===|!==|==|!=|\\?\\?=?|\\?\\.|\\.\\.|\\*\\*|[-+*/%]=?|>=?|\\?|:"
        }
      ]
    },
    "tag-control": {
      "begin": "(</?)(if|elif|else|for|while|match|case|default|try|catch|finally|return|break|continue|throw)(?=[\\s/>])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        },
        "2": {
          "name": "keyword.control.flow.kscript entity.name.tag.kscript"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        }
      },
      "name": "meta.tag.kscript",
      "patterns": [
        {
          "match": "\\b([A-Za-z_][\\w.:-]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.kscript"
            },
            "2": {
              "name": "punctuation.separator.key-value.kscript"
            }
          }
        },
        {
          "include": "#attribute-value-double"
        },
        {
          "include": "#attribute-value-single"
        }
      ]
    },
    "tag-declaration": {
      "begin": "(</?)(let|set|const|state|fn|import)(?=[\\s/>])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        },
        "2": {
          "name": "storage.type.kscript entity.name.tag.kscript"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        }
      },
      "name": "meta.tag.kscript",
      "patterns": [
        {
          "match": "\\b([A-Za-z_][\\w.:-]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.kscript"
            },
            "2": {
              "name": "punctuation.separator.key-value.kscript"
            }
          }
        },
        {
          "include": "#attribute-value-double"
        },
        {
          "include": "#attribute-value-single"
        }
      ]
    },
    "json-block": {
      "comment": "The text of an element with format=\"json\" (for example <echo format=\"json\">) is JSON, highlighted by VS Code's JSON grammar.",
      "begin": "(<)([A-Za-z_][\\w.:-]*)(?=[^>]*\\bformat\\s*=\\s*[\"']json[\"'])((?:[^>\"']|\"[^\"]*\"|'[^']*')*?)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        },
        "2": {
          "name": "entity.name.tag.kscript"
        },
        "3": {
          "name": "meta.tag.kscript",
          "patterns": [
            {
              "match": "\\b([A-Za-z_][\\w.:-]*)\\s*(=)",
              "captures": {
                "1": {
                  "name": "entity.other.attribute-name.kscript"
                },
                "2": {
                  "name": "punctuation.separator.key-value.kscript"
                }
              }
            },
            {
              "include": "#attribute-value-double"
            },
            {
              "include": "#attribute-value-single"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.kscript"
        }
      },
      "end": "(</)(\\2)\\s*(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        },
        "2": {
          "name": "entity.name.tag.kscript"
        },
        "3": {
          "name": "punctuation.definition.tag.kscript"
        }
      },
      "contentName": "meta.embedded.block.json",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#cdata-json"
        },
        {
          "include": "source.json"
        }
      ]
    },
    "cdata-json": {
      "begin": "<!\\[CDATA\\[",
      "end": "]]>",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.cdata.kscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.cdata.kscript"
        }
      },
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    "typed-literals": {
      "patterns": [
        {
          "match": "(?<![\\w)\\]$'\"])/(?![\\s/*])(?:\\\\.|\\[(?:\\\\.|[^\\]\\\\\\n])*\\]|[^/\\\\\\n\\[])+/[imsx]*(?!\\w)",
          "name": "string.regexp.kscript"
        },
        {
          "match": "(?<![\\w.%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+(?![\\w]|-(?!>))",
          "name": "string.unquoted.email.kscript"
        },
        {
          "match": "(?<![\\w-])[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\w-]|-(?!>))",
          "name": "constant.other.uuid.kscript"
        }
      ]
    }
  }
