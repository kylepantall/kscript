{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KScript",
  "scopeName": "source.kscript",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#cdata"
    },
    {
      "include": "#declaration"
    },
    {
      "include": "#tag"
    },
    {
      "include": "#entity"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#bare-reference"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.kscript",
      "begin": "<!--",
      "end": "-->"
    },
    "cdata": {
      "name": "string.unquoted.cdata.kscript",
      "begin": "<!\\[CDATA\\[",
      "end": "]]>"
    },
    "declaration": {
      "name": "meta.tag.preprocessor.kscript",
      "begin": "<\\?",
      "end": "\\?>"
    },
    "entity": {
      "name": "constant.character.entity.kscript",
      "match": "&(?:[A-Za-z]+|#\\d+|#x[0-9A-Fa-f]+);"
    },
    "tag": {
      "begin": "(</?)([A-Za-z_][\\w.:-]*)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        },
        "2": {
          "name": "entity.name.tag.kscript"
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.kscript"
        }
      },
      "name": "meta.tag.kscript",
      "patterns": [
        {
          "match": "\\b([A-Za-z_][\\w.:-]*)\\s*(=)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.kscript"
            },
            "2": {
              "name": "punctuation.separator.key-value.kscript"
            }
          }
        },
        {
          "include": "#attribute-value-double"
        },
        {
          "include": "#attribute-value-single"
        }
      ]
    },
    "attribute-value-double": {
      "name": "meta.attribute-value.kscript",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kscript"
        }
      },
      "patterns": [
        {
          "include": "#entity"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#strings"
        },
        {
          "name": "constant.numeric.kscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.kscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        },
        {
          "name": "keyword.operator.word.kscript",
          "match": "\\b(and|or|not|eq|ne|lt|le|gt|ge|in|step)\\b"
        },
        {
          "name": "storage.type.function.kscript",
          "match": "\\b(fn|match)\\b"
        },
        {
          "name": "constant.language.kscript",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.kscript",
          "match": "\\|>|=>|===|!==|==|!=|\\?\\?=?|\\?\\.|\\.\\.|\\*\\*|[-+*/%]=?|>=?|\\?|:"
        }
      ]
    },
    "attribute-value-single": {
      "name": "meta.attribute-value.kscript",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kscript"
        }
      },
      "patterns": [
        {
          "include": "#entity"
        },
        {
          "include": "#interpolation"
        },
        {
          "name": "constant.numeric.kscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.kscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        },
        {
          "name": "keyword.operator.word.kscript",
          "match": "\\b(and|or|not|eq|ne|lt|le|gt|ge|in|step)\\b"
        },
        {
          "name": "storage.type.function.kscript",
          "match": "\\b(fn|match)\\b"
        },
        {
          "name": "constant.language.kscript",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.kscript",
          "match": "\\|>|=>|===|!==|==|!=|\\?\\?=?|\\?\\.|\\.\\.|\\*\\*|[-+*/%]=?|>=?|\\?|:"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.kscript",
          "match": "'[^']*'"
        },
        {
          "name": "string.quoted.double.kscript",
          "match": "\"[^\"]*\""
        }
      ]
    },
    "interpolation": {
      "name": "meta.embedded.expression.kscript",
      "begin": "\\{!?(?!\\{)",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.kscript"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.kscript"
        }
      },
      "patterns": [
        {
          "include": "#map-literal"
        },
        {
          "include": "#strings"
        },
        {
          "name": "constant.numeric.kscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.kscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        },
        {
          "name": "keyword.operator.word.kscript",
          "match": "\\b(and|or|not|eq|ne|lt|le|gt|ge|in|step)\\b"
        },
        {
          "name": "storage.type.function.kscript",
          "match": "\\b(fn|match)\\b"
        },
        {
          "name": "constant.language.kscript",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.kscript",
          "match": "\\|>|=>|===|!==|==|!=|\\?\\?=?|\\?\\.|\\.\\.|\\*\\*|[-+*/%]=?|>=?|\\?|:"
        }
      ]
    },
    "map-literal": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#map-literal"
        },
        {
          "include": "#strings"
        },
        {
          "name": "constant.numeric.kscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "variable.other.kscript",
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        },
        {
          "match": "(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        },
        {
          "name": "keyword.operator.word.kscript",
          "match": "\\b(and|or|not|eq|ne|lt|le|gt|ge|in|step)\\b"
        },
        {
          "name": "storage.type.function.kscript",
          "match": "\\b(fn|match)\\b"
        },
        {
          "name": "constant.language.kscript",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.kscript",
          "match": "\\|>|=>|===|!==|==|!=|\\?\\?=?|\\?\\.|\\.\\.|\\*\\*|[-+*/%]=?|>=?|\\?|:"
        }
      ]
    },
    "bare-reference": {
      "patterns": [
        {
          "match": "(\\$[A-Za-z_][A-Za-z0-9_]*)((?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "variable.other.kscript"
            },
            "2": {
              "name": "variable.other.property.kscript"
            }
          }
        },
        {
          "name": "entity.name.function.command.kscript",
          "match": "(?<![\\w.])@[A-Za-z_][A-Za-z0-9_]*(?=\\()"
        },
        {
          "match": "(->)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.arrow.kscript"
            },
            "2": {
              "name": "entity.name.function.method.kscript"
            }
          }
        }
      ]
    }
  }
}