--- make
unless: passkeys
to: {{ paths.components }}/forgot-password-form.kscript
---
import KScript.Web
import KScript.Auth

/// Asks for the email to send a reset link to. It posts to /forgot-password,
/// which flashes the same message whether or not the email has an account.
type ForgotPasswordForm extends Component {
  construct({ error?: string })

  fn render() => ```html
    <status-message />
    <p class="error" @if($error != null)>{$error}</p>
    <form method="post" action="/forgot-password">
      {! @csrf_field() }
      <p><label>Email<br><input type="email" name="email" required autocomplete="email"></label></p>
      <p><button>Send me a link</button></p>
    </form>
    ```
}
