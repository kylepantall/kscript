--- make
to: {{ paths.controllers }}/accounts.kscript
---
// Signing up, in and out{{#unless passkeys}} and password resets{{/unless}}{{#if api}}, and API tokens{{/if}}, made by kscript make auth.
// The routes are in {{ routes_file }}, the pages in {{ paths.views }}/auth/
// and their parts in {{ paths.components }}/. The account page's components
// make and revoke API tokens and passkeys themselves. KScript.Auth keeps the
// users, sessions and tokens, and checks the CSRF token every form sends with
// {! @csrf_field() } (see the Sign-in guide).
import KScript.Http
import KScript.Auth
{{#unless passkeys}}
import "{{ sign_up_import }}"
{{/unless}}

/// GET /login
fn show_login() => @view('auth/login', data: {})

{{#unless passkeys}}
/// POST /login: a wrong email or password shows the form again. After a few
/// wrong tries, @attempt makes them wait.
fn sign_in(form: map) {
  user = null
  try {
    user = @attempt($form.email ?? '', $form.password ?? '', remember: $form.remember == 'yes')
  } catch TooManyRequests as err {
    return @view('auth/login', data: { error: $err.message, email: $form.email }, status: 429)
  }
  if $user == null {
    return @view('auth/login', data: { error: "That email and password don't match an account.", email: $form.email }, status: 422)
  }
  return @redirect(@intended())
}

{{/unless}}
/// GET /register
fn show_register() => @view('auth/register', data: {})

{{#unless passkeys}}
/// POST /register: makes the account and signs it in.
fn sign_up(form: map) {
  user = null
  try {
    data = SignUp($form)
    user = @register($data.email, $data.password, name: $data.name->trim())
  } catch Shape | Validation as err {
    return @view('auth/register', data: { problems: $err.problems ?? [], name: $form.name, email: $form.email }, status: 422)
  }
  @login($user)
  return @redirect(@intended())
}

{{/unless}}
/// POST /logout
fn sign_out() {
  @logout()
  return @redirect(/)
}

{{#unless passkeys}}
/// GET /forgot-password
fn show_forgot() => @view('auth/forgot-password', data: {})

/// POST /forgot-password: the answer is the same whether or not the email has
/// an account.
fn send_reset(form: map, request: map) {
  token = @reset_token($form.email ?? '')
  if $token != null {
    site = ($request.scheme ?? 'http') + '://' + ($request.headers.host ?? 'localhost')
    link = $site + @route('password.reset', token: $token)
    // Email $link to $form.email with your mail provider. Until then, it is
    // written to the server's log.
    log "Password reset link for {$form.email}: {$link}"
  }
  $session->flash('status', 'If that email has an account, a link to reset its password is on its way.')
  return @redirect(/forgot-password)
}

/// GET /reset-password/:token
fn show_reset(token: string) => @view('auth/reset-password', data: { token: $token })

/// POST /reset-password: sets the new password, ends the account's other
/// sessions and signs it in here.
fn reset(form: map) {
  user = null
  try {
    user = @reset_password($form.token ?? '', $form.password ?? '')
  } catch Validation as err {
    return @view('auth/reset-password', data: { token: $form.token, error: $err.message }, status: 422)
  }
  if $user == null {
    expired = 'That link has expired or was already used. Ask for a new one.'
    return @view('auth/forgot-password', data: { error: $expired }, status: 422)
  }
  @login($user)
  $session->flash('status', 'Your password has been changed.')
  return @redirect(/account)
}

{{/unless}}
{{#if api}}

{{#unless passkeys}}
/// POST {{ api_prefix }}/tokens with a JSON email and password: answers with a
/// new API token.
fn issue_token(json: map) {
  user = @attempt($json.email ?? '', $json.password ?? '', session: false)
  if $user == null {
    throw Unauthorized "That email and password don't match an account."
  }
  return @response({ token: @api_token($user, name: $json.device ?? 'api') }, status: 201)
}

{{/unless}}
/// GET {{ api_prefix }}/me with Authorization: Bearer <token>
fn me() => @user()
{{/if}}
