// kscript make project --template fullstack reads this file to learn about the template. It is not copied into new projects.
// Every other file in this folder is copied, with {{ }} placeholders filled in (see docs/projects.md).
{
  "description": "A web app with its own JSON API: pages that call /api through @api, routes, controllers, a Note model in a database, caching and tests",
  "options": {
    "syntax": {
      "question": "Which syntax for scripts?",
      "default": "kscript",
      "choices": ["kscript", "xml"],
      "description": "kscript writes scripts, tests and routes as .kscript files; xml writes them as .ks.xml. Pages stay HTML."
    },
    "db": {
      "question": "Which database?",
      "default": "sqlite",
      "choices": ["sqlite", "postgres", "mysql", "none"],
      "description": "The database the notes are kept in (KScript.Data). none keeps them in a JSON file instead."
    },
    "auth": {
      "question": "Add sign-in (KScript.Auth)?",
      "default": false,
      "description": "Sign-in pages (kscript make auth): notes belong to who is signed in, and the API needs a session or an API token."
    },
    "cache": {
      "question": "Cache the notes list (KScript.Cache)?",
      "default": true,
      "description": "Cache the notes list (KScript.Cache) and answer repeat API requests with 304 Not Modified."
    },
    "docker": {
      "question": "Add Docker (a Dockerfile and compose.yaml)?",
      "default": false,
      "description": "Add a Dockerfile and compose.yaml (with the database server, for postgres and mysql)."
    },
    "port": {
      "question": "Which port should kscript serve use?",
      "default": 8080,
      "description": "The port kscript serve uses"
    }
  },
  // kscript make kits run in the new project once its files are written.
  "make": ["{{#if auth}}auth{{/if}}"],
  // Printed after the project is made. Lines that come out empty are left out.
  "notes": [
    "{{#if db in postgres, mysql}}the app keeps its data in {{ db }}, at the url in config/config{{ ext }} (DATABASE_URL overrides it){{#if docker}}, and docker compose up starts the database too{{/if}}. kscript test uses SQLite in memory, so tests need no database server.{{/if}}"
  ],
  // Printed after the project is made, under "Next:". Lines that come out empty are left out.
  "next": [
    "kscript serve           serve the site at http://localhost:{{ port }} and its API under /api (docs at /_api)",
    "kscript routes          list the routes in routes/",
    "kscript test            run the tests in tests/",
    "kscript check           check every page and script",
    "{{#if docker}}docker compose up       run the app{{#unless db in sqlite, none}} and its database{{/unless}} in containers{{/if}}",
    "kscript ide install     add the KScript extension to VS Code (the project also recommends it)"
  ]
}
