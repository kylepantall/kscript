// Tests for the JSON API (routes/api{{ ext }}). @api('/api/...') sends a
// request to this app's own routes, without a
// server. kscript test uses config/config.test.yaml, so these notes never reach the real {{#if db is none}}notes file{{else}}database{{/if}}.
import KScript.Net
{{#if auth}}
import KScript.Auth

/// Makes a user for one test, with the headers that send their API token.
fn test_user() {
  user = @register('test-' + @uuid() + '@example.com', 'correct horse battery staple', name: 'Test')
  return { id: $user.id, headers: { Authorization: 'Bearer ' + @api_token($user, name: 'test') } }
}
{{/if}}

/// Sends a request to the notes API{{#if auth}} as a test user{{/if}}.
fn notes_api(path: string, method: string = 'GET', body = null{{#if auth}}, as = {}{{/if}}) {
  return @api('/api/notes' + $path, options: { method: $method, body: $body{{#if auth}}, headers: $as.headers ?? {}{{/if}} })
}

describe(name: "api") {
{{#if auth}}
  // Each test gets a user of its own (in before_each), so no test sees
  // another's notes.
  me = {}

{{/if}}
  before_each {
{{#if auth}}
    me = @test_user()
{{else}}
    for note in @notes_api('')->json() {
      @notes_api('/' + $note.id, method: 'DELETE')
    }
{{/if}}
  }
{{#if auth}}

  after_each {
    @users()->delete($me.id)
  }
{{/if}}

  test(name: "GET /api/health says the API is up") {
    expect(value: @api('/api/health')->json().ok, equals: true)
  }

  test(name: "a new note is saved and listed") {
    added = @notes_api('', method: 'POST', body: { title: 'Write the docs' }{{#if auth}}, as: $me{{/if}})
    expect(value: $added.status, equals: 201)
    note = $added->json()
    expect(value: @notes_api('/' + $note.id{{#if auth}}, as: $me{{/if}})->json().title, equals: 'Write the docs')
    expect(value: @notes_api(''{{#if auth}}, as: $me{{/if}})->json()->map(fn(n) => $n.title), equals: ['Write the docs'])
  }

  test(name: "a note without a title is turned away with 422") {
    expect(value: @notes_api('', method: 'POST', body: { title: '' }{{#if auth}}, as: $me{{/if}}).status, equals: 422)
  }

  test(name: "a note is changed and deleted") {
    note = @notes_api('', method: 'POST', body: { title: 'Ship it' }{{#if auth}}, as: $me{{/if}})->json()
    changed = @notes_api('/' + $note.id, method: 'PUT', body: { title: 'Ship it', done: true }{{#if auth}}, as: $me{{/if}})
    expect(value: $changed->json().done, equals: true)
    expect(value: @notes_api('/' + $note.id, method: 'DELETE'{{#if auth}}, as: $me{{/if}}).status, equals: 204)
    expect(value: @notes_api('/' + $note.id{{#if auth}}, as: $me{{/if}}).status, equals: 404)
  }
{{#if auth}}

  test(name: "notes need a session or a token, and only their owner sees them") {
    expect(value: @notes_api('').status, equals: 401)
    note = @notes_api('', method: 'POST', body: { title: 'Mine' }, as: $me)->json()
    other = @test_user()
    expect(value: @notes_api('/' + $note.id, as: $other).status, equals: 404)
    @users()->delete($other.id)
  }
{{/if}}
}
