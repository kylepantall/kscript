// Tests for the JSON API (routes/api{{ ext }}). @api(/api/...) sends a
// request to this app's own routes, without a
// server. The config script selects storage for the test environment.
import KScript.Net
{{#if examples}}
{{#if auth}}
import KScript.Auth

/// Makes a user for one test, with the headers that send their API token.
fn test_user() {
  user = @register('test-' + @uuid() + '@example.com', 'correct horse battery staple', name: 'Test')
  return { id: $user.id, headers: { Authorization: 'Bearer ' + @api_token($user, name: 'test') } }
}
{{/if}}

/// Sends a request to the notes API{{#if auth}} as a test user{{/if}}.
fn notes_api(path: slash_path = /, post = null, put = null, delete: bool = false{{#if auth}}, as = {}{{/if}}) {
  return @api(/api/notes + $path, post: $post, put: $put, delete: $delete{{#if auth}}, options: { headers: $as.headers ?? {} }{{/if}})
}

describe(name: "api") {
{{#if auth}}
  // Each test gets a user of its own (in before_each), so no test sees
  // another's notes.
  me = {}

{{/if}}
  before_each {
{{#if auth}}
    me = @test_user()
{{else}}
    for note in @notes_api()->json() {
      @notes_api(/$note.id, delete: true)
    }
{{/if}}
  }
{{#if auth}}

  after_each {
    @users()->delete($me.id)
  }
{{/if}}

  test(name: "GET /api/health says the API is up") {
    expect(@api(/api/health)->json().ok, equals: true)
  }

  test(name: "a new note is saved and listed") {
    added = @notes_api(/, post: { title: 'Write the docs' }{{#if auth}}, as: $me{{/if}})
    expect($added.status, equals: 201)
    note = $added->json()
    expect(@notes_api(/$note.id{{#if auth}}, as: $me{{/if}})->json().title, equals: 'Write the docs')
    expect(@notes_api({{#if auth}}as: $me{{/if}})->json()->map(.title), equals: ['Write the docs'])
  }

  test(name: "a note without a title is turned away with 422") {
    expect(@notes_api(/, post: { title: '' }{{#if auth}}, as: $me{{/if}}).status, equals: 422)
  }

  test(name: "a note is changed and deleted") {
    note = @notes_api(/, post: { title: 'Ship it' }{{#if auth}}, as: $me{{/if}})->json()
    changed = @notes_api(/$note.id, put: { title: 'Ship it', done: true }{{#if auth}}, as: $me{{/if}})
    expect($changed->json().done, equals: true)
    expect(@notes_api(/$note.id, delete: true{{#if auth}}, as: $me{{/if}}).status, equals: 204)
    expect(@notes_api(/$note.id{{#if auth}}, as: $me{{/if}}).status, equals: 404)
  }
{{#if auth}}

  test(name: "notes need a session or a token, and only their owner sees them") {
    expect(@notes_api().status, equals: 401)
    note = @notes_api(/, post: { title: 'Mine' }, as: $me)->json()
    other = @test_user()
    expect(@notes_api(/$note.id, as: $other).status, equals: 404)
    @users()->delete($other.id)
  }
{{/if}}
}
{{else}}

test(name: "GET /api/health says the API is up") {
  expect(@api(/api/health)->json().ok, equals: true)
}
{{/if}}
