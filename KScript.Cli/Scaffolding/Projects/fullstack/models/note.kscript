--- make
when: examples
unless: db is none
---
// The Note model: a type whose records live in the notes table (KScript.Data,
// see docs/data.md).
import KScript.Data

/// A note{{#if auth}} that belongs to the user who wrote it{{/if}}.
model Note(auto_create{{#if auth}}, index: [user_id], hidden: [user_id]{{/if}}) extends Timestamps {
{{#if auth}}
  user_id: string
{{/if}}
  title: string(min: 1, max: 200)
  body: string = ''
  done: bool = false
}
