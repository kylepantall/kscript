// The JSON API, served by kscript serve under /api (see docs/http.md). kscript
// routes lists the routes, and /_api shows their docs. Each route is answered
// by a controller function; a map or list it returns is JSON.
KScript.Routes(middleware: [cors, request_id]) {
{{#if auth}}
  import KScript.Auth
{{/if}}
  import "../middleware/request_id{{ ext }}"
{{#if auth}}
  import "../controllers/accounts{{ ext }}" as accounts
{{/if}}
  import "../controllers/notes{{ ext }}" as notes

  /// Says the API is up.
  Get(path: "/health") {
    return { ok: true, app: $config.app.name }
  }
{{#if auth}}

  // Sign up, then trade an email and password for a token. Send it as
  // Authorization: Bearer <token>.
  Group(middleware: "throttle:10") {
    Post(path: "/register", to: @accounts.sign_up)
    Post(path: "/tokens", to: @accounts.issue_token)
  }
  Group(middleware: auth) {
    Get(path: "/me", to: @accounts.profile)
    Delete(path: "/me", to: @accounts.close_account)
    Resource(path: "/notes", to: notes{{#if cache}}, middleware: etag{{/if}})
  }
{{else}}

  Resource(path: "/notes", to: notes{{#if cache}}, middleware: etag{{/if}})
{{/if}}
}
