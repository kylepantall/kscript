{
  "$schema": "https://raw.githubusercontent.com/kylepantall/kscript/master/editors/vscode/schemas/kscript.schema.json",
  "name": "{{ kebab }}",
  "standard": "kscript:recommended",
  "serve": {
    "root": ".",
    "port": {{ port }},
    "host": "localhost"
  },
  "http": {
    // Every route logs its request; routes/api{{ ext }} adds the app's own middleware.
    "middleware": ["log"]
  },
  // The app's own settings, read as $config (such as $config.app.name).
  // kscript.test.json changes them for tests. Settings read from environment
  // variables go in config{{ ext }}.
  "config": {
{{#if db is none}}
    "notes": { "file": "data/notes.json" },
{{else}}
    "database": {
      "connections": {
{{#if db is sqlite}}
        "main": { "url": "sqlite:data/app.sqlite" }
{{else}}
        "main": {
          "driver": "{{ db }}",
          "host": "localhost",
          "port": {{#if db is postgres}}5432{{else}}3306{{/if}},
          "database": "{{ snake }}",
          "username": "{{ snake }}",
          "password": "secret"
        }
{{/if}}
      }
    },
{{/if}}
{{#if cache}}
    "cache": { "store": "memory", "ttl": "5m" },
{{/if}}
    "app": { "name": "{{ title }}" }
  },
  // kscript make writes new scripts and tests in this syntax: kscript (.kscript files) or xml (.ks.xml).
  "make": {
    "syntax": "{{ syntax }}"
  },
  "lint": {
    "include": ["**/*.kscript", "**/*.ks.xml"],
    "exclude": ["_templates", "node_modules", "dist"]
  },
  "test": {
    "include": ["tests/**/*.test.kscript", "tests/**/*.test.ks.xml"],
    // Tests run in the test environment, so kscript.test.json gives them their own data.
    "env": "test"
  }
}
