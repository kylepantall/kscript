// The selected environment is passed during config loading.
fn configure(environment: string) {
  testing = $environment == 'test'
{{#unless db is none}}
  configured_url = @env('DATABASE_URL', default: '')
  main = $testing ? { url: 'sqlite::memory:' } : { url: $configured_url }
  if !$testing and $configured_url->is_blank() {
{{#if db is sqlite}}
    main = { url: 'sqlite:data/app.sqlite' }
{{else}}
    main = {
      driver: '{{ db }}'
      host: @env('DB_HOST', default: 'localhost')
      port: @env('DB_PORT', default: '{{#if db is postgres}}5432{{else}}3306{{/if}}')
      database: @env('DB_NAME', default: '{{ snake }}')
      username: @env('DB_USER', default: '{{ snake }}')
      password: @env('DB_PASSWORD', default: 'secret')
    }
{{/if}}
  }
{{/unless}}
  return {
    app: { name: $testing ? '{{ title }} (tests)' : '{{ title }}' }
{{#if db is none}}
    notes: { file: $testing ? 'data/test/notes.json' : 'data/notes.json' }
{{else}}
    database: {
      connections: {
        main: $main
      }
    }
{{/if}}
{{#if cache}}
    cache: { store: $testing ? 'memory' : @env('CACHE_STORE', default: 'memory'), ttl: 5m }
{{/if}}
  }
}
