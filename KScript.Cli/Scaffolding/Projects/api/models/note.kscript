--- make
unless: db is none
---
// The Note model: a type whose records live in the notes table (KScript.Data,
// see docs/data.md).
import KScript.Data
{{#if auth}}
import KScript.Auth
{{/if}}

/// A note{{#if auth}} that belongs to the user who wrote it{{/if}}.
model Note(auto_create) extends {{#if auth}}[Ownable, Timestamps]{{else}}Timestamps{{/if}} {
  title: string(min: 1, max: 200)
  body: string = ''
  done: bool = false
}
