// Tests for the notes API (controllers/notes{{ ext }}). @api(/api/...) sends
// a request to this app's own routes,
// without a server. the config script selects test storage, so these notes never reach the real {{#if db is none}}notes file{{else}}database{{/if}}.
import KScript.Net
{{#if auth}}

/// Signs up someone new and gives the headers that send their API token.
fn sign_up() {
  email = 'test-' + @uuid() + '@example.com'
  body = { name: 'Test', email: $email, password: 'correct horse battery staple' }
  account = @api(/api/register, post: $body)->check()->json()
  return { Authorization: 'Bearer ' + $account.token }
}
{{/if}}

/// Sends a request to the notes API{{#if auth}} as the test's user{{/if}}.
fn notes_api(path: slash_path = /, post = null, put = null, delete: bool = false{{#if auth}}, as = {}{{/if}}) {
  return @api(/api/notes + $path, post: $post, put: $put, delete: $delete{{#if auth}}, options: { headers: $as }{{/if}})
}

describe(name: "notes") {
{{#if auth}}
  // Each test signs up someone new (in before_each), so no test sees another's
  // notes.
  me = {}

{{/if}}
  before_each {
{{#if auth}}
    me = @sign_up()
{{else}}
    for note in @notes_api()->json() {
      @notes_api(/$note.id, delete: true)
    }
{{/if}}
  }
{{#if auth}}

  after_each {
    @api(/api/me, delete: true, options: { headers: $me })
  }
{{/if}}

  test(name: "the list starts empty") {
    expect(@notes_api({{#if auth}}as: $me{{/if}})->json(), equals: [])
  }

  test(name: "a new note is saved and listed") {
    added = @notes_api(/, post: { title: 'Write the docs' }{{#if auth}}, as: $me{{/if}})
    expect($added.status, equals: 201)
    note = $added->json()
    expect($note.title, equals: 'Write the docs')
    expect($note.done, equals: false)
    expect(@notes_api(/$note.id{{#if auth}}, as: $me{{/if}})->json().title, equals: 'Write the docs')
    expect(@notes_api({{#if auth}}as: $me{{/if}})->json()->map(.title), equals: ['Write the docs'])
  }

  test(name: "a note without a title is turned away with 422") {
    expect(@notes_api(/, post: { title: '' }{{#if auth}}, as: $me{{/if}}).status, equals: 422)
  }

  test(name: "a note is changed and deleted") {
    note = @notes_api(/, post: { title: 'Ship it' }{{#if auth}}, as: $me{{/if}})->json()
    changed = @notes_api(/$note.id, put: { title: 'Ship it', done: true }{{#if auth}}, as: $me{{/if}})
    expect($changed->json().done, equals: true)
    expect(@notes_api(/$note.id, delete: true{{#if auth}}, as: $me{{/if}}).status, equals: 204)
    expect(@notes_api(/$note.id{{#if auth}}, as: $me{{/if}}).status, equals: 404)
  }
{{#if auth}}

  test(name: "notes need a token, and only their owner sees them") {
    expect(@notes_api().status, equals: 401)
    note = @notes_api(/, post: { title: 'Mine' }, as: $me)->json()
    other = @sign_up()
    expect(@notes_api(/$note.id, as: $other).status, equals: 404)
    expect(@notes_api(/, as: $other)->json(), equals: [])
    @api(/api/me, delete: true, options: { headers: $other })
  }
{{/if}}
{{#if cache}}

  test(name: "a client that has the list already gets 304 Not Modified") {
    first = @notes_api({{#if auth}}as: $me{{/if}})
    tag = $first->header('ETag')
    again = @api(/api/notes, options: { headers: { 'If-None-Match': $tag{{#if auth}}, Authorization: $me.Authorization{{/if}} } })
    expect($again.status, equals: 304)
  }
{{/if}}
}
