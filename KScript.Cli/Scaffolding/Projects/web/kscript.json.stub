{
  "$schema": "https://raw.githubusercontent.com/kylepantall/kscript/master/editors/vscode/schemas/kscript.schema.json",
  "name": "{{ kebab }}",
  "standard": "kscript:recommended",
  "serve": {
    "root": ".",
    "port": {{ port }},
    "host": "localhost"
  },
{{#if http}}
  "http": {
    "middleware": ["log"]
  },
{{/if}}
{{#if desktop}}
  "app": {
    "main": "desktop{{ ext }}",
    "name": "{{ title }}",
    "id": "app.kscript.{{ kebab }}",
    "version": "1.0.0"
  },
{{/if}}
  // $config reads config/config.yaml (and config.<env>.yaml with kscript --env <env>).
  "config": {
    "root": "config"
  },
  // kscript make writes new scripts and tests in this syntax: kscript (.kscript files) or xml (.ks.xml).
  "make": {
    "syntax": "{{ syntax }}"
  },
  "lint": {
    "include": ["**/*.html", "**/*.md", "**/*.kscript", "**/*.ks.xml"],
    "exclude": ["_templates", "node_modules", "dist"],
    "rules": {},
    "warnings_as_errors": false
  },
  "test": {
    "include": ["tests/**/*.test.kscript", "tests/**/*.test.ks.xml"],
    "timeout": 10
  }
}
