--- make
when: desktop
---
// {{ title }} as a desktop app. Open it with: kscript desktop{{ ext }}
// Compile it into a program with: kscript compile (the "app" section of
// kscript.json names this file). The rules come from lib/tasks{{ ext }}, the
// same file the web page (tasks.html) uses.
import KScript.UI
import "lib/tasks{{ ext }}"

Window(title: "{{ title }}", width: 480, height: 560, theme: system) {
  tasks = @starter_tasks()
  draft = ''

  Text(size: 24, weight: bold) "{{ title }}"

  Row(gap: 8) {
    TextBox(bind: draft, placeholder: "What needs doing?", width: 320,
      on_enter: { tasks = @add_task($tasks, title: $draft); draft = '' })
    Button(variant: primary, on_click: { tasks = @add_task($tasks, title: $draft); draft = '' }) "Add"
  }

  Column(gap: 4, scroll) {
    for t in $tasks {
      // A tick box needs a variable to bind to: this row's copy of the task's
      // done flag.
      done = $t.done
      Row(gap: 8) {
        CheckBox(bind: done, on_change: { tasks = @toggle_task($tasks, id: $t.id) }) "{$t.title}"
        Button(on_click: { tasks = @remove_task($tasks, id: $t.id) }, tooltip: "Remove") "✕"
      }
    }
  }

  Row(gap: 8) {
    Text "{ @tasks_left($tasks) }"
    Button(on_click: { tasks = @clear_done($tasks) }, disabled: not $tasks->any(.done)) "Clear done"
  }
}
