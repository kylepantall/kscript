// The app's rules. The web page (tasks.html){{#if desktop}}, the desktop window (desktop{{ ext }}){{/if}}{{#if http}}, the API (controllers/tasks{{ ext }}){{/if}}
// and the tests (tests/tasks.test{{ ext }}) all import this file, so the logic
// is written once. A task is a map: { id: 1, title: 'Buy milk', done: false }.

/// The list with a new task at the end. A blank title leaves the list as it is.
fn add_task(tasks: list, title: string) {
  clean = $title->trim()
  if $clean == '' {
    return $tasks
  }
  id = $tasks->count() == 0 ? 1 : $tasks->map(fn($t) => $t.id)->max() + 1
  return $tasks->push({ id: $id, title: $clean, done: false })
}

/// The list with one task ticked or unticked.
fn toggle_task(tasks: list, id: int) => $tasks->map(fn($t) => $t.id == $id ? $t->set(key: 'done', value: not $t.done) : $t)

/// The list without one task.
fn remove_task(tasks: list, id: int) => $tasks->reject(fn($t) => $t.id == $id)

/// The list without the finished tasks.
fn clear_done(tasks: list) => $tasks->reject(fn($t) => $t.done)

/// How many tasks are not done yet, as text: '1 task left'.
fn tasks_left(tasks: list) {
  n = $tasks->count_of(fn($t) => not $t.done)
  return $n + ($n == 1 ? ' task left' : ' tasks left')
}

/// The tasks a new list starts with.
fn starter_tasks() {
  tasks = @add_task([], title: 'Try the web app: kscript serve')
  return @add_task($tasks, title: '{{#if desktop}}Try the desktop app: kscript desktop{{ ext }}{{else}}Run the tests: kscript test{{/if}}')
}
