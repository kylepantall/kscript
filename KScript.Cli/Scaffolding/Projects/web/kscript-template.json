// kscript make project reads this file to learn about the template. It is not copied into new projects.
// Every other file in this folder is copied, with {{ }} placeholders filled in (see docs/projects.md).
{
  "description": "A web app: pages, a layout, a live Tasks page, a script and tests, plus the same app as a desktop window",
  "options": {
    "format": {
      "question": "Which file format for scripts?",
      "default": "kscript",
      "choices": ["kscript", "xml"],
      "description": "kscript writes scripts, tests, routes and the desktop app as .kscript files; xml writes them as .ks.xml. Pages stay HTML."
    },
    "desktop": {
      "question": "Add a desktop app (the same app in a window)?",
      "default": true,
      "description": "Add desktop.kscript (the app in a <KScript.Window>) and the kscript.json app settings kscript compile uses. --no-desktop leaves them out."
    },
    "http": {
      "question": "Add a JSON API under /api?",
      "default": true,
      "description": "Add a JSON API (routes/api.kscript and controllers/tasks.kscript, served under /api by KScript.Http). --no-http leaves it out."
    },
    "port": {
      "question": "Which port should kscript serve use?",
      "default": 8080,
      "description": "The port kscript serve uses"
    }
  },
  // Printed after the project is made, under "Next:". Lines that come out empty are left out.
  "next": [
    "kscript serve           serve the site at http://localhost:{{ port }} (settings in kscript.json)",
    "{{#if desktop}}kscript desktop{{ ext }}{{#if xml}} {{/if}} open the desktop app; kscript compile builds it as a program{{/if}}",
    "{{#if http}}kscript routes          list the API routes in routes/api{{ ext }} (GET http://localhost:{{ port }}/api/tasks){{/if}}",
    "kscript test            run the tests in tests/",
    "kscript check           check every page and script",
    "kscript ide install     add the KScript extension to VS Code (the project also recommends it)"
  ]
}
