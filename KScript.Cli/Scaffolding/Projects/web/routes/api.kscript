--- make
when: http
---
// The JSON API, served by kscript serve under /api (see docs/http.md). kscript
// routes lists the routes. GET /api/tasks gives the tasks; POST /api/tasks with
// { "title": "..." } adds one.
import KScript.Http
import "../controllers/tasks{{ ext }}" as tasks

Routes(middleware: cors) {
  Get(path: "/health") {
    return { ok: true }
  }
  Resource(path: "/tasks", to: tasks)
}
