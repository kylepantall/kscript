// Run every test in the project with: kscript test
import "../lib/greeting{{ ext }}"

describe(name: "greeting") {
  test(name: "says hello") {
    expect(@greeting('Joan'), equals: 'Hello, Joan!')
  }

  for name in ['  joan ', 'JOAN', 'joan'] {
    test(name: "tidies '{$name}'") {
      expect(@greeting($name), equals: 'Hello, Joan!')
    }
  }
}

test(name: "scripts/hello{{ ext }} greets the name it is given") {
  run = @run_script('../scripts/hello{{ ext }}', options: { args: ['ellie'] })
  expect($run.code, equals: 0)
  expect($run.output, equals: 'Hello, Ellie!')
}
