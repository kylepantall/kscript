--- make
description: Constants in lib/: values that never change, shared by every script that imports the file
category: Scripts and data
usage: <name> [--values "max_items = 10, site_name = 'Shop'"]
--values: The constants, comma separated, as name = value (default an example)
example: kscript make const limits --values "max_items = 10, page_size = 25"
example: kscript make const app --values "name = 'Shop', version = '1.0'"
to: {{ paths.lib }}/{{ dir }}{{ kebab }}{{ ext }}
hint: Import it with import "{{ paths.lib }}/{{ dir }}{{ kebab }}{{ ext }}", then use the values as $name
---
// {{ title }}: values that can't change. Scripts that import this file see each one as $name.
{{#each values}}
const {{ item }}
{{else}}
const {{ snake }}_limit = 10
{{/each}}
