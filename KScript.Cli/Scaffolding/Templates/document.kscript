--- make
description: A document script in documents/ that writes a PDF and a Word file (KScript.Document)
category: Documents
usage: <name> [--template paper|report|plain] [--syntax kscript|xml]
--template: The look: paper, report or plain (default paper)
--syntax: kscript or xml (default the project's make.syntax)
example: kscript make document annual-report --template report
example: kscript make document papers/gliders
to: {{ paths.documents }}/{{ dir }}{{ kebab }}{{ ext }}
hint: Build it: kscript {{ paths.documents }}/{{ dir }}{{ kebab }}{{ ext }} (writes {{ kebab }}.pdf and {{ kebab }}.docx next to it). See the Documents guide for tables, figures and citations.
---
// Add .tex, .md or .html to to: for those formats too.
import KScript.Document

Document(
  template: {{ template ?? paper }},
  title: "{{ title }}",
  author: "Your Name",
  to: ["{{ kebab }}.pdf", "{{ kebab }}.docx"]
) {
  Abstract "One paragraph on what this document is about."

  Section(title: "Introduction", id: "intro") {
    Paragraph "Text can be **bold** or *italic*, hold maths such as \( e^{i\pi} + 1 = 0 \), \
      and footnotes.^[Like this one.]"
  }

  Section(title: "Results") {
    Math(id: "eq-main") "\bar{x} = \frac{1}{n} \sum_{i=1}^{n} x_i"

    Paragraph "Equation [#eq-main] is the mean. Section [#intro] has the background."

    Table(caption: "Results.", align: ['left', 'right']) {
      Tr(header: true) "Measure | Value"
      Tr "Mean | 4.2"
      Tr "Count | 12"
    }
  }
}
