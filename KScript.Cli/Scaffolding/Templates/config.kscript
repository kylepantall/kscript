--- make
description: Settings for $config: config.kscript for values that need code, or kscript.<env>.json for one environment
category: Settings
usage: <base|environment>
example: kscript make config base
example: kscript make config staging
to: {{ paths.project }}/{{#if name in base, default, config}}config{{ ext }}{{else}}kscript.{{ kebab }}.json{{/if}}
hint: {{#if name in base, default, config}}configure(environment) runs when $config is first read, and its map is laid over the "config" section of kscript.json{{else}}kscript --env {{ kebab }} (or KSCRIPT_ENV={{ kebab }}) lays this file's "config" section over kscript.json's{{/if}}
---
{{#if name in base, default, config}}
// Settings that need code, such as values from @env(). The map this returns is
// laid over the "config" section of kscript.json.
fn configure(environment: string) {
  return {
    app: { debug: $environment == 'development' }
    api: { token: @env('API_TOKEN', default: '') }
  }
}
{{else}}
{
  // Laid over the "config" section of kscript.json when the environment is {{ kebab }}.
  "config": {
    "app": { "debug": false }
  }
}
{{/if}}
