--- make
description: A queued job in jobs/: dispatch it with dispatch Name(...), and kscript worker runs it, retrying when it fails
category: Scripts and data
usage: <Name> [--fields "user_id: int, email: email"] [--queue mail] [--tries 5] [--backoff "10s, 1m, 5m"] [--timeout 30s]
--fields: The fields, comma separated, as name: type, with ? for optional and = for a default (default: none)
--queue: The queue it goes on (default: default)
--tries: How many attempts it gets before it counts as failed (default: 3)
--backoff: How long to wait before each retry, such as "10s, 1m, 5m" (default: exponential)
--timeout: The longest one attempt may run, such as 30s or 5m (default: 60s)
example: kscript make job SendWelcome --fields "user_id: int, email: email" --queue mail --tries 5
example: kscript make job reports/BuildReport --fields "month: int" --timeout 5m
to: {{ paths.jobs }}/{{ dir }}{{ kebab }}{{ ext }}
hint: Queue it: import "{{ paths.jobs }}/{{ dir }}{{ kebab }}{{ ext }}", then dispatch {{ pascal }}(...). Run the queue with kscript worker (kscript queue failed lists failures).
---
/// {{ title }}.
job {{ pascal }}({{#if queue}}queue: "{{ queue }}", {{/if}}{{#if tries}}tries: {{ tries }}, {{/if}}{{#if backoff}}backoff: "{{ backoff }}", {{/if}}timeout: "{{#if timeout}}{{ timeout }}{{else}}60s{{/if}}") {
{{#each fields}}
  {{ item | trim }}
{{/each}}

  fn handle() {
    // Do the work here. An error retries the job after its backoff, until its tries run out.
    log "{{ title }}"
  }

  /// Runs once, when the job has used up its tries.
  fn failed(err) {
    log(level: error, fields: { error: $err.message }) "{{ title }} failed"
  }
}
