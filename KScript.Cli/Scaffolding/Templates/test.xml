--- make
description: A test file in tests/, run with kscript test
base: project
to: tests/{{ dir }}{{ kebab }}.test.ks.xml
hint: Run it: kscript test tests/{{ dir }}{{ kebab }}.test.ks.xml
---
<kscript>
  <!-- Bring in what you're testing, e.g. <import src="../lib/{{ kebab }}.ks.xml" /> -->

  <describe name="{{ title }}">
    <test name="adds numbers">
      <expect value="1 + 2" equals="3" />
    </test>

    <test name="joins text">
      <assert test="['a', 'b']->join('-') eq 'a-b'" />
    </test>
  </describe>
</kscript>
