--- make
description: A test file in tests/, run with kscript test
category: Tests
usage: <name> [--format kscript|xml]
--format: kscript or xml (default the project's make.format)
example: kscript make test checkout
example: kscript make test api/people
base: project
to: {{ paths.tests }}/{{ dir }}{{ kebab }}.test{{ ext }}
hint: Run it: kscript test {{ paths.tests }}/{{ dir }}{{ kebab }}.test{{ ext }}
---
// Bring in what you're testing, e.g. import "../{{ paths.lib }}/{{ kebab }}{{ ext }}"

describe(name: "{{ title }}") {
  // TODO: Replace these examples with tests of your own code.
  test(name: "adds numbers") {
    expect(value: 1 + 2, equals: 3)
  }

  test(name: "joins text") {
    assert(test: ['a', 'b']->join('-') == 'a-b')
  }
}
