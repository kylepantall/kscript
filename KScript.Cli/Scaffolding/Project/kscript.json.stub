{
  "$schema": "https://raw.githubusercontent.com/kylepantall/kscript/master/editors/vscode/schemas/kscript.schema.json",
  "name": "{{ kebab }}",
  "serve": {
    "root": ".",
    "port": {{ port }},
    "host": "localhost"
  },
{{#if desktop}}
  "app": {
    "main": "desktop.ks.xml",
    "name": "{{ title }}",
    "id": "app.kscript.{{ kebab }}",
    "version": "1.0.0"
  },
{{/if}}
  "lint": {
    "include": ["**/*.html", "**/*.md", "**/*.ks.xml"],
    "exclude": ["_templates", "node_modules", "dist"],
    "rules": {},
    "warningsAsErrors": false
  },
  "test": {
    "include": ["tests/**/*.test.ks.xml"],
    "timeout": 10
  }
}
