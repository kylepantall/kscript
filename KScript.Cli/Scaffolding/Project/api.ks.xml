--- make
when: http
---
<!--
  The JSON API, served by kscript serve under /api (see docs/http.md). kscript routes lists the routes.
  GET /api/tasks gives the tasks; POST /api/tasks with { "title": "..." } adds one.
-->
<KScript.Routes middleware="cors">
  <import src="controllers/tasks.ks.xml" as="tasks" />

  <Get path="/health">
    <return value="{ ok: true }" />
  </Get>
  <Resource path="/tasks" to="tasks" />
</KScript.Routes>
