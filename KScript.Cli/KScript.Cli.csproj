<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript</RootNamespace>
    <AssemblyName>KScript.Cli</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>The kscript command line: make, ide, update and run.</Description>
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>

  <!-- Only tagged release builds can promise a Git revision the Docker generator can fetch. -->
  <ItemGroup Condition="'$(GITHUB_REF_TYPE)' == 'tag' and '$(GITHUB_REPOSITORY)' == 'kylepantall/kscript'">
    <AssemblyMetadata Include="KScriptPublishedRevision" Value="$(GITHUB_SHA)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in templates for kscript make -->
    <EmbeddedResource Include="Scaffolding\Templates\*" LogicalName="KScript.Scaffolding.Templates.%(Filename)%(Extension)" WithCulture="false" />
    <!-- kscript make project: every file under Scaffolding/Projects/<template>, by its path (dot-x is written as .x). WithCulture=false: otherwise MSBuild reads hello.ks.xml as a Kashmiri (ks) resource. -->
    <EmbeddedResource Include="Scaffolding\Projects\**\*" WithCulture="false" LogicalName="KScript.Scaffolding.Projects/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Shared source libraries used by the offline API and fullstack project templates. -->
    <EmbeddedResource Include="..\libraries\app-cache\index.kscript" WithCulture="false" LogicalName="KScript.Scaffolding.Libraries/app-cache" />
    <EmbeddedResource Include="..\libraries\request-id\index.kscript" WithCulture="false" LogicalName="KScript.Scaffolding.Libraries/request-id" />
    <EmbeddedResource Include="Scaffolding\Docker\*" WithCulture="false" LogicalName="KScript.Scaffolding.Docker/%(Filename)%(Extension)" />
    <!-- kscript make auth: the sign-in controller, views and routes, by their path under Scaffolding/Auth. -->
    <EmbeddedResource Include="Scaffolding\Auth\**\*" WithCulture="false" LogicalName="KScript.Scaffolding.Auth/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KScript.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KScript.Core\KScript.Core.csproj" />
    <ProjectReference Include="..\KScript.Web\KScript.Web.csproj" />
    <!-- The formatter, so XML output of kscript make is laid out as kscript fmt would. -->
    <ProjectReference Include="..\KScript.Language\KScript.Language.csproj" />
  </ItemGroup>

</Project>
