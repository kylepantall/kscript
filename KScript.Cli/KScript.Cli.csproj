<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>KScript</RootNamespace>
    <AssemblyName>KScript.Cli</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>2.0.0</Version>
    <Product>KScript</Product>
    <Description>The kscript command line: make, ide, update and run.</Description>
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built-in templates for kscript make -->
    <EmbeddedResource Include="Scaffolding\Templates\*" LogicalName="KScript.Scaffolding.Templates.%(Filename)%(Extension)" />
    <!-- kscript make project: every file under Scaffolding/Project, by its path (dot-x is written as .x). WithCulture=false: otherwise MSBuild reads hello.ks.xml as a Kashmiri (ks) resource. -->
    <EmbeddedResource Include="Scaffolding\Project\**\*" WithCulture="false" LogicalName="KScript.Scaffolding.Project/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KScript.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KScript.Core\KScript.Core.csproj" />
    <ProjectReference Include="..\KScript.Web\KScript.Web.csproj" />
  </ItemGroup>

</Project>
